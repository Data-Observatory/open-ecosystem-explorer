{
	"name": "openscience-ecosystem",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prebuild": "npm run validate && npm run layout:check",
		"postbuild": "node scripts/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && npm run paraglide:compile",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url baseLocale",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:coverage": "vitest run --coverage --testTimeout=120000",
		"test:e2e": "playwright test",
		"validate": "tsx scripts/validate.ts",
		"schema:generate": "tsx scripts/generate-schema.ts",
		"layout:generate": "tsx scripts/layout-graph.ts",
		"layout:check": "tsx scripts/layout-graph.ts --check",
		"review": "tsx scripts/review.ts",
		"watch:validate": "tsx scripts/watch-validate.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.8",
		"vitest": "^5.0.0",
		"zod-to-json-schema": "^3.25.2"
	},
	"dependencies": {
		"spdx-license-ids": "^3.0.24",
		"yaml": "^2.9.1",
		"zod": "^3.25.76"
	}
}
