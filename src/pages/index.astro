---
// The language gateway (specs.md §7.2's `/` row): a static page listing
// available languages as plain links, with hreflang alternates and an
// immediate (0-second) meta refresh to the default locale. No content of
// its own — nothing duplicated, nothing hidden from a no-JS or
// screen-reader user. Redirects to the real per-locale home page
// (Phase 7's `[locale]/index.astro` — earlier phases had no such page,
// so this used to redirect straight into an arbitrary entity page).
import { locales, defaultLocale } from '../i18n/locales.js';

const defaultTarget = `/${defaultLocale}/`;
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>openscience-ecosystem</title>
    {locales.map(({ code }) => <link rel="alternate" hreflang={code} href={`/${code}/`} />)}
    <link rel="alternate" hreflang="x-default" href="/" />
    <meta http-equiv="refresh" content={`0; url=${defaultTarget}`} />
  </head>
  <body>
    <p>openscience-ecosystem</p>
    <ul>
      {locales.map(({ code, label }) => (
        <li>
          <a href={`/${code}/`} hreflang={code} lang={code}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>

<style>
  /* §9.2 2.5.8: >=24px clickable target, same rule as Base.astro's list
     links — this page doesn't use Base (it's the pre-locale gateway). */
  ul {
    list-style: none;
    padding: 0;
  }
  li a {
    display: inline-block;
    padding: 0.4rem 0.2rem;
    min-height: 24px;
    box-sizing: border-box;
  }
</style>
