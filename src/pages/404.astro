---
// specs.md §7 `/404` row: "near-match suggestions." Top-level, not
// locale-prefixed (a broken/mistyped URL might not even carry a valid
// locale segment) — defaults its own chrome to the default locale's UI
// strings and lets the client script, which knows the actual requested
// path, suggest real entity ids via simple string-distance matching.
import { getSiteIndex } from '../content/site-index.js';
import { resolveProse } from '../lib/i18n/resolve.js';
import { defaultLocale } from '../i18n/locales.js';
import { getUiStrings } from '../i18n/ui.js';

const index = await getSiteIndex();
const ui = getUiStrings(defaultLocale);
const allIds = [...index.entities.keys()].map((id) => ({ id, name: resolveProse(index, id, defaultLocale).prose.name ?? index.entities.get(id)!.name }));
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — openscience-ecosystem</title>
  </head>
  <body>
    <main>
      <h1>404</h1>
      <p>{defaultLocale === 'es' ? 'Página no encontrada.' : 'Page not found.'}</p>
      <p id="suggestion-intro" hidden>{defaultLocale === 'es' ? 'Quizás quisiste decir:' : 'Did you mean:'}</p>
      <ul id="suggestions"></ul>
      <p><a href={`/${defaultLocale}/`}>{ui.nav.entities}</a></p>
    </main>
    <script type="application/json" id="entity-ids" set:html={JSON.stringify(allIds)} is:inline />
    <script is:inline>
      (function () {
        const data = JSON.parse(document.getElementById('entity-ids').textContent);
        const path = location.pathname.toLowerCase();
        const match = /entity\/([a-z0-9-]+)/.exec(path);
        const needle = (match ? match[1] : path.split('/').filter(Boolean).pop() || '').replace(/-/g, '');
        if (!needle) return;

        function distance(a, b) {
          const dp = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
          for (let j = 0; j <= b.length; j++) dp[0][j] = j;
          for (let i = 1; i <= a.length; i++) {
            for (let j = 1; j <= b.length; j++) {
              dp[i][j] = a[i - 1] === b[j - 1] ? dp[i - 1][j - 1] : 1 + Math.min(dp[i - 1][j - 1], dp[i - 1][j], dp[i][j - 1]);
            }
          }
          return dp[a.length][b.length];
        }

        const ranked = data
          .map((e) => ({ ...e, d: distance(needle, e.id.replace(/-/g, '')) }))
          .sort((a, b) => a.d - b.d)
          .slice(0, 5)
          .filter((e) => e.d <= Math.max(3, needle.length * 0.5));

        if (ranked.length === 0) return;
        document.getElementById('suggestion-intro').hidden = false;
        const list = document.getElementById('suggestions');
        for (const r of ranked) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/es/entity/${r.id}/`;
          a.textContent = r.name;
          li.appendChild(a);
          list.appendChild(li);
        }
      })();
    </script>
  </body>
</html>
