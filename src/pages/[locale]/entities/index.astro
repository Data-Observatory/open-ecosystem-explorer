---
// Master entity index (specs.md §7 `/{loc}/entities` row). Per §9/A9.5 this
// page IS the site-wide accessible equivalent of the global map (/map,
// Phase 6 follow-up) — built solid, server-rendered, works with no JS.
// Sorting/filtering here is by real links (type/tag), not client-side
// controls; a progressive-enhancement sort script is Phase 7 polish, not
// required for this page to be fully functional without JS.
import Base from '../../../layouts/Base.astro';
import { getSiteIndex } from '../../../content/site-index.js';
import { getEntityTypesVocab } from '../../../content/vocab-index.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import { getUiStrings } from '../../../i18n/ui.js';
import type { EntityId } from '../../../lib/model/types.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
const index = await getSiteIndex();
const vocab = await getEntityTypesVocab();

function name(id: EntityId): string {
  return index.prose.get(locale)?.get(id)?.name ?? index.entities.get(id)?.name ?? id;
}

const rows = [...index.entities.values()]
  .map((e) => ({
    id: e.id,
    name: name(e.id),
    type: e.type,
    typeLabel: vocab.get(e.type)?.label[locale] ?? e.type,
    governance: e.governance,
    status: e.status,
    degree: (index.degree.get(e.id)?.in ?? 0) + (index.degree.get(e.id)?.out ?? 0),
    lastReviewed: e.lastReviewed,
  }))
  .sort((a, b) => a.typeLabel.localeCompare(b.typeLabel) || a.name.localeCompare(b.name));

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/entities/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${ui.nav.entities} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{ui.nav.entities}</h1>
  <p>{rows.length} {locale === 'es' ? 'entidades en total.' : 'entities total.'}</p>

  <table class="entity-index">
    <caption class="visually-hidden">{locale === 'es' ? 'Todas las entidades' : 'All entities'}</caption>
    <thead>
      <tr>
        <th scope="col">{locale === 'es' ? 'Nombre' : 'Name'}</th>
        <th scope="col">{locale === 'es' ? 'Tipo' : 'Type'}</th>
        <th scope="col">{locale === 'es' ? 'Gobernanza' : 'Governance'}</th>
        <th scope="col">{locale === 'es' ? 'Estado' : 'Status'}</th>
        <th scope="col">{locale === 'es' ? 'Grado' : 'Degree'}</th>
        <th scope="col">{ui.entity.lastReviewed}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>
              <a href={`/${locale}/entity/${r.id}/`}>{r.name}</a>
            </td>
            <td>
              <a href={`/${locale}/entities/${r.type}/`}>{r.typeLabel}</a>
            </td>
            <td>{r.governance}</td>
            <td>{r.status}</td>
            <td>{r.degree}</td>
            <td>{r.lastReviewed}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<style>
  .entity-index {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .entity-index th,
  .entity-index td {
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--border, #d0d7de);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
