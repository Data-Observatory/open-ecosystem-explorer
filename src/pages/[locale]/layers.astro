---
// The orientation page (specs.md §7 `/{loc}/layers` row, §6.3 "Layer stack").
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/Diagram.astro';
import { getSiteIndex } from '../../content/site-index.js';
import { getEntityTypesVocab } from '../../content/vocab-index.js';
import { buildLayerStackDiagram, describeLayerStack, computeLayerRows } from '../../lib/mermaid/layers.js';
import { renderMermaidToInlineSvg } from '../../lib/mermaid/render.js';
import { locales, type LocaleCode } from '../../i18n/locales.js';
import { getUiStrings } from '../../i18n/ui.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
const index = await getSiteIndex();
const vocab = await getEntityTypesVocab();

const source = buildLayerStackDiagram(index, vocab, locale);
const { html: svgHtml } = await renderMermaidToInlineSvg(source, locale);
const description = describeLayerStack(index, vocab, locale);
const rows = computeLayerRows(index, vocab, locale);

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/layers/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${ui.nav.layers} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{ui.nav.layers}</h1>
  <p>
    {locale === 'es'
      ? 'De abajo hacia arriba: identificadores, agencias de registro, índices y sistemas institucionales, más una capa regional y una banda transversal de estándares, comunidades y coaliciones.'
      : 'Bottom to top: identifiers, registration agencies, indices and institutional systems, plus a regional layer and a cross-cutting band of standards, communities and coalitions.'}
  </p>

  <Diagram
    svgHtml={svgHtml}
    caption={description.caption}
    description={description.description}
    rows={description.rows}
    idPrefix="layers"
    locale={locale}
  />

  {
    [...new Set(rows.map((r) => r.layer))].map((layer) => {
      const layerRows = rows.filter((r) => r.layer === layer);
      return (
        <section aria-label={layerRows[0]!.layerLabel}>
          <h2>{layerRows[0]!.layerLabel}</h2>
          <ul>
            {layerRows.map((r) => (
              <li>
                <a href={`/${locale}/entities/${r.type}/`}>{r.typeLabel}</a> ({r.count})
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</Base>
