---
// The data model page (specs.md §7 `/{loc}/model` row): the schema itself,
// plus I1-I31 rendered FROM rules.ts's own RULES metadata (added this
// phase) so published documentation cannot drift from the enforced rules.
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/Diagram.astro';
import { getSiteIndex } from '../../content/site-index.js';
import { buildModelErDiagram, describeModel } from '../../lib/mermaid/model.js';
import { renderMermaidToInlineSvg } from '../../lib/mermaid/render.js';
import { locales, type LocaleCode } from '../../i18n/locales.js';
import { getUiStrings } from '../../i18n/ui.js';
import { RULES } from '../../lib/invariants/rules.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
const index = await getSiteIndex();

const source = buildModelErDiagram(index.predicates);
const { html: svgHtml } = await renderMermaidToInlineSvg(source, locale);
const description = describeModel(index.predicates, locale);

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/model/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${locale === 'es' ? 'Modelo de datos' : 'Data model'} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{locale === 'es' ? 'Modelo de datos' : 'Data model'}</h1>
  <p>
    {locale === 'es'
      ? 'Generado directamente desde vocab/predicates.yaml y vocab/entity-types.yaml — esta página no puede desviarse de las reglas que realmente se aplican.'
      : 'Generated directly from vocab/predicates.yaml and vocab/entity-types.yaml — this page cannot drift from the rules actually enforced.'}
  </p>

  <Diagram svgHtml={svgHtml} caption={description.caption} description={description.description} rows={description.rows} idPrefix="model" locale={locale} />

  <h2>{locale === 'es' ? 'Invariantes de construcción (I1–I31)' : 'Build-time invariants (I1–I31)'}</h2>
  <table>
    <caption class="visually-hidden">{locale === 'es' ? 'Lista de invariantes' : 'Invariant list'}</caption>
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">{locale === 'es' ? 'Nivel' : 'Level'}</th>
        <th scope="col">{ui.entity.description}</th>
      </tr>
    </thead>
    <tbody>
      {
        RULES.map((rule) => (
          <tr>
            <td>{rule.id}</td>
            <td>{rule.level}</td>
            <td>{rule.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<style>
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 1rem; }
  th, td { text-align: left; padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--border, #d0d7de); vertical-align: top; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
