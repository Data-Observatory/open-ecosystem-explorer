---
// One page per fault-line view (specs.md §7 `/{loc}/views/[id]` row, §5.6,
// §6.3 "View" row). `predicate`-kind queries reuse predicate-map.ts's
// diagram/table wholesale (it already produces exactly this shape);
// `entities`/`explicit` queries get a generic entity-summary table plus a
// best-effort internal-edges diagram when render allows it — I25 (build-time
// empty-result error) is enforced in scripts/validate.ts, not here.
import Base from '../../../layouts/Base.astro';
import Diagram from '../../../components/Diagram.astro';
import { getSiteIndex } from '../../../content/site-index.js';
import { getViewsData, resolveViewProse } from '../../../content/views-index.js';
import { resolveViewQuery, describeEntitySet, activeOptionalColumns } from '../../../lib/views/query.js';
import { buildPredicateMapDiagram, describePredicateMap } from '../../../lib/mermaid/predicate-map.js';
import { renderMermaidSource } from '../../../lib/mermaid/flowchart.js';
import { renderMermaidToInlineSvg } from '../../../lib/mermaid/render.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import type { NodeSpec } from '../../../lib/mermaid/flowchart.js';
import type { EntityId } from '../../../lib/model/types.js';

export async function getStaticPaths() {
  const data = await getViewsData();
  const ids = [...data.views.keys()];
  return locales.flatMap(({ code: locale }) => ids.map((id) => ({ params: { locale, id } })));
}

const { locale, id } = Astro.params as { locale: LocaleCode; id: string };
const index = await getSiteIndex();
const data = await getViewsData();
const view = data.views.get(id)!;
const { prose, fallback } = resolveViewProse(data, id, locale);
const resolved = resolveViewQuery(index, view.query, locale);

let svgHtml: string | undefined;
let diagramCaption = '';
let diagramDescription = '';
let diagramRows: { subjectName: string; subjectType: string; predicateLabel: string; objectName: string; objectType: string; since?: string; note?: string }[] = [];
let entityRows: ReturnType<typeof describeEntitySet> = [];
let columns: ReturnType<typeof activeOptionalColumns> = [];

if (view.query.kind === 'predicate') {
  const d = describePredicateMap(index, view.query.predicate, locale);
  diagramCaption = d.caption;
  diagramDescription = d.description;
  diagramRows = d.rows;
  if (view.render !== 'table') {
    const source = buildPredicateMapDiagram(index, view.query.predicate, locale);
    svgHtml = source ? (await renderMermaidToInlineSvg(source, locale)).html : undefined;
  }
} else {
  entityRows = describeEntitySet(index, resolved.entityIds, locale);
  columns = activeOptionalColumns(index, resolved.entityIds);
  if (view.render !== 'table') {
    const idSet = new Set(resolved.entityIds);
    const nodes = new Map<EntityId, NodeSpec>();
    for (const eid of resolved.entityIds) {
      const e = index.entities.get(eid)!;
      nodes.set(eid, { id: eid, type: e.type, name: index.prose.get(locale)?.get(eid)?.name ?? e.name });
    }
    const internalEdges = index.edges
      .filter((e) => !e.derived && idSet.has(e.from) && idSet.has(e.to))
      .map((e) => ({
        from: e.from,
        to: e.to,
        predicate: e.predicate,
        style: (index.predicates.get(e.predicate)?.style.line === 'thick' ? 'thick' : index.predicates.get(e.predicate)?.style.line === 'dashed' ? 'dashed' : 'solid') as 'solid' | 'dashed' | 'thick',
        label: index.predicates.get(e.predicate)?.label[locale] ?? e.predicate,
        since: e.since,
        note: e.note,
      }));
    if (internalEdges.length > 0) {
      svgHtml = (await renderMermaidToInlineSvg(renderMermaidSource(index, nodes, internalEdges, locale), locale)).html;
    }
    diagramCaption = prose.title;
    diagramDescription = prose.question;
  }
}

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/views/${id}/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${prose.title} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{prose.title}</h1>
  <p class="question">{prose.question}</p>
  {fallback && (
    <p role="note" lang="es">
      {locale === 'es'
        ? 'Esta línea de falla aún no está traducida al inglés — mostrando el original en español.'
        : 'This fault line is not yet translated into English — showing the Spanish original.'}
    </p>
  )}
  <div lang={fallback ? 'es' : locale} set:html={prose.body} />

  {svgHtml && (
    <Diagram svgHtml={svgHtml} caption={diagramCaption} description={diagramDescription} rows={diagramRows} idPrefix={`view-${id}`} locale={locale} />
  )}

  {view.query.kind !== 'predicate' && (
    <table class="entity-set">
      <caption class="visually-hidden">{prose.title}</caption>
      <thead>
        <tr>
          <th scope="col">{locale === 'es' ? 'Nombre' : 'Name'}</th>
          <th scope="col">{locale === 'es' ? 'Tipo' : 'Type'}</th>
          <th scope="col">{locale === 'es' ? 'Gobernanza' : 'Governance'}</th>
          {columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {entityRows.map((r) => (
          <tr>
            <td><a href={`/${locale}/entity/${r.id}/`}>{r.name}</a></td>
            <td>{r.type}</td>
            <td>{r.governance}</td>
            {columns.map((c) => <td>{r.optional[c] ?? '—'}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <p class="sources">
    {locale === 'es' ? 'Fuentes' : 'Sources'}:{' '}
    {view.sources.map((s, i) => (
      <>
        {i > 0 ? ', ' : ''}<a href={s.url}>{s.title ?? s.url}</a>
      </>
    ))}
  </p>
</Base>

<style>
  .question { font-style: italic; color: var(--muted-fg, #57606a); }
  .entity-set { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 1rem; }
  .entity-set th, .entity-set td { text-align: left; padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--border, #d0d7de); }
  .sources { font-size: 0.85rem; margin-top: 2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
