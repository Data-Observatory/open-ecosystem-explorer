---
// The fault-line analyses list (specs.md §7 `/{loc}/views` row, §5.6).
import Base from '../../../layouts/Base.astro';
import { getViewsData, resolveViewProse } from '../../../content/views-index.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import { getUiStrings } from '../../../i18n/ui.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
const data = await getViewsData();

const rows = [...data.views.keys()]
  .sort()
  .map((id) => ({ id, ...resolveViewProse(data, id, locale) }));

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/views/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${ui.nav.views} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{ui.nav.views}</h1>
  <p>
    {locale === 'es'
      ? 'Las cinco líneas de falla del ecosistema [M§9], expresadas como consultas guardadas sobre el grafo (§5.6).'
      : "The ecosystem's five fault lines [M§9], expressed as saved queries over the graph (§5.6)."}
  </p>
  <ul class="view-list">
    {rows.map((r) => (
      <li>
        <a href={`/${locale}/views/${r.id}/`}>{r.prose.title}</a>
        <p>{r.prose.question}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .view-list { list-style: none; padding: 0; }
  .view-list li { padding: 0.75rem 0; border-bottom: 1px solid var(--border, #d0d7de); }
  .view-list a { font-weight: 600; }
  .view-list p { margin: 0.25rem 0 0; color: var(--muted-fg, #57606a); }
</style>
