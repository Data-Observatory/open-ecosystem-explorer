---
// Global map (specs.md §7 `/{loc}/map` row). Thin route wrapper around the
// shared `MapExplorerV2` component (src/components/MapExplorerV2.astro),
// which holds the whole explorer (hierarchical layout, class-box nodes,
// fetch-injected inline full record) shared with `/{loc}/map2`. Promoted
// here 2026-09-07 — see that file's header comment for the full history.
// This page renders the WHOLE corpus with `showAdvanced` (facet chips,
// Focus mode, URL query-state); `/{loc}/map2` renders a fixed curated
// subset without those, for a first-time visitor.
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import MapExplorerV2 from '../../../components/MapExplorerV2.astro';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const simpleLinkCopy = { es: '¿Prefieres una vista más simple?', en: 'Prefer a simpler view?' } as const;
---

<MapExplorerV2 locale={locale} crossLinkHref={`/${locale}/map2/`} crossLinkLabel={simpleLinkCopy[locale]} showAdvanced />
