---
// Tag index (specs.md §7 `/{loc}/tags/[tag]` row has no list page of its own;
// this is the entry point the tag pages were missing). Tags grouped by
// namespace (`function:`, `region:`, ...) with entity counts, each linking to
// its existing `/{loc}/tags/[tag]/` page.
import Base from '../../../layouts/Base.astro';
import { getSiteIndex } from '../../../content/site-index.js';
import { getTagsVocab } from '../../../content/vocab-index.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import { getUiStrings } from '../../../i18n/ui.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
const index = await getSiteIndex();
const tagsVocab = await getTagsVocab();

const counts = new Map<string, number>();
for (const e of index.entities.values()) for (const t of e.tags) counts.set(t, (counts.get(t) ?? 0) + 1);

// Same set as `[tag].astro`'s getStaticPaths (tags actually in use).
const namespaces = ui.tagsIndex.namespaces as Record<string, string>;
const groups = new Map<string, { tag: string; label: string; count: number }[]>();
for (const tag of [...counts.keys()].sort()) {
  const colon = tag.indexOf(':');
  const ns = colon === -1 ? 'other' : tag.slice(0, colon);
  const full = tagsVocab.get(tag)?.label[locale] ?? tag;
  // Labels read "función: registro"; the namespace is already the group heading.
  const label = full.includes(': ') ? full.slice(full.indexOf(': ') + 2) : full;
  if (!groups.has(ns)) groups.set(ns, []);
  groups.get(ns)!.push({ tag, label, count: counts.get(tag)! });
}
for (const items of groups.values()) items.sort((a, b) => a.label.localeCompare(b.label, locale));
const orderedGroups = [...groups.entries()].sort(([a], [b]) => (a === 'other' ? 1 : b === 'other' ? -1 : a.localeCompare(b)));

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/tags/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${ui.tagsIndex.title} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{ui.tagsIndex.title}</h1>
  <p>{ui.tagsIndex.intro}</p>

  {
    orderedGroups.map(([ns, items]) => (
      <section aria-labelledby={`ns-${ns}`}>
        <h2 id={`ns-${ns}`}>{namespaces[ns] ?? ns}</h2>
        <ul>
          {items.map((i) => (
            <li>
              <a href={`/${locale}/tags/${i.tag}/`}>{i.label}</a> ({i.count} {ui.tagsIndex.entities})
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
