---
// One page per tag (specs.md §7 `/{loc}/tags/[tag]` row): entities sharing a
// tag, plus their interconnections. Judgment call: a full Mermaid diagram is
// overkill for what are typically small tag groups (a handful of entities) —
// this page uses a plain entity list + a compact relations table among just
// that tag's members, matching the "list+relations table" alternative the
// plan explicitly allowed for this route.
import Base from '../../../layouts/Base.astro';
import { getSiteIndex } from '../../../content/site-index.js';
import { getTagsVocab } from '../../../content/vocab-index.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import type { EntityId } from '../../../lib/model/types.js';

export async function getStaticPaths() {
  const index = await getSiteIndex();
  const tags = new Set<string>();
  for (const e of index.entities.values()) for (const t of e.tags) tags.add(t);
  return locales.flatMap(({ code: locale }) => [...tags].sort().map((tag) => ({ params: { locale, tag } })));
}

const { locale, tag } = Astro.params as { locale: LocaleCode; tag: string };
const index = await getSiteIndex();
const tagsVocab = await getTagsVocab();
const tagLabel = tagsVocab.get(tag)?.label[locale] ?? tag;

function name(id: EntityId): string {
  return index.prose.get(locale)?.get(id)?.name ?? index.entities.get(id)?.name ?? id;
}

const memberIds = new Set([...index.entities.values()].filter((e) => e.tags.includes(tag)).map((e) => e.id));
const members = [...memberIds].sort((a, b) => name(a).localeCompare(name(b)));

const internalEdges = index.edges.filter((e) => !e.derived && memberIds.has(e.from) && memberIds.has(e.to));

const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/tags/${tag}/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${tagLabel} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <h1>{tagLabel}</h1>
  <p>{members.length} {locale === 'es' ? 'entidades con esta etiqueta.' : 'entities carrying this tag.'}</p>

  <ul>
    {members.map((id) => (
      <li>
        <a href={`/${locale}/entity/${id}/`}>{name(id)}</a>
      </li>
    ))}
  </ul>

  {
    internalEdges.length > 0 && (
      <>
        <h2>{locale === 'es' ? 'Interconexiones' : 'Interconnections'}</h2>
        <table>
          <caption class="visually-hidden">{locale === 'es' ? `Relaciones entre entidades con la etiqueta ${tagLabel}` : `Relations among entities tagged ${tagLabel}`}</caption>
          <tbody>
            {internalEdges.map((e) => (
              <tr>
                <td><a href={`/${locale}/entity/${e.from}/`}>{name(e.from)}</a></td>
                <td>{index.predicates.get(e.predicate)?.label[locale] ?? e.predicate}</td>
                <td><a href={`/${locale}/entity/${e.to}/`}>{name(e.to)}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</Base>

<style>
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  td { padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border, #d0d7de); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
