---
// specs.md §7 `/{loc}/changelog` row: rendered CHANGELOG.md.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../layouts/Base.astro';
import { renderMarkdown } from '../../../lib/markdown/render.js';
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import { getUiStrings } from '../../../i18n/ui.js';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const ui = getUiStrings(locale);
// process.cwd(), not import.meta.url: Astro's static build bundles this
// component's code into dist/chunks/, so a URL relative to the SOURCE file
// resolves to the wrong directory at build time (works in dev, breaks in
// `astro build`) — the same reasoning src/content/site-index.ts already
// documents for vocab loading.
const changelogMd = readFileSync(join(process.cwd(), 'CHANGELOG.md'), 'utf-8');
const changelogHtml = renderMarkdown(changelogMd);
const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/changelog/`])) as Record<LocaleCode, string>;
---

<Base locale={locale} title={`${ui.nav.changelog} — openscience-ecosystem`} switcherHrefs={switcherHrefs}>
  <div class="rendered-md" set:html={changelogHtml} />
</Base>
