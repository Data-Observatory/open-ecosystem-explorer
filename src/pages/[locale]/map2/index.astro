---
// Curated "essential concepts" map (Opus review follow-up: the full
// `/{loc}/map` grew to 133 entities/178 edges after the content audit — too
// dense for a first-time visitor). Renders via `MapExplorerV2.astro`, the
// SAME component `/{loc}/map` uses (promoted 2026-09-07 — see that file's
// header comment for history) — this route just passes a curated
// `entityIds` subset and omits `showAdvanced` (facet chips/Focus mode/URL
// state stay `/map`-only clutter at this smaller scale). See specs.md §7's
// `/map2` row.
import { locales, type LocaleCode } from '../../../i18n/locales.js';
import MapExplorerV2 from '../../../components/MapExplorerV2.astro';

export async function getStaticPaths() {
  return locales.map(({ code: locale }) => ({ params: { locale } }));
}

// Deliberately fixed, not derived — this is a curated hand-picked set, not a
// query. Keep in sync with specs.md §7's `/map2` row if it ever changes.
// Extended (2026-09-06) with 3 entities that give the previously-isolated
// FAIR/COAR/DSpace a real position in the hierarchy instead of floating
// disconnected — see CHANGELOG.md for the research behind each addition:
// `unesco-recommendation-open-science` (mandates FAIR — already true in the
// full corpus, just not previously included here), `coar-notify` (developed-
// by COAR — likewise), `oai-pmh` (implemented by DSpace/Zenodo/Dataverse
// alike — a shared standard node that also demonstrates the "shared
// selection" highlight across 3 different repositories at once).
//
// Extended again (2026-09-06, same day, follow-up pass after the 4-tier
// hierarchy landed — see hierarchy.ts): FAIR was the set's only real T4
// ("principles") example, so the new tier split looked like a one-off
// rather than a rule. 6 more entities, each verified to connect into the
// set that already existed (no floaters):
//  - `dona-foundation` — governs `handle-system` (governed-by; also gives
//    Handle System, previously a near-leaf, a real T2 parent)
//  - `international-doi-foundation` — governs `doi` (governed-by; already
//    authored)
//  - `force11` — developed `fair` (developed-by; already authored)
//  - `ourresearch` — operates `openalex` (operated-by; already authored —
//    removes the "OpenAlex has no institutional parent" asymmetry against
//    Scopus/WoS/Dimensions, which all have one)
//  - `trust-principles` + `coretrustseal` — TRUST was a T4 principles
//    standard; it is now a concept (principles, not a standard), so it falls
//    to the default tier, and CoreTrustSeal (T3 certification-criteria)
//    stays `certified-by`-held by `zenodo` (T1 repository).
//  - `fair4rs` — a still-standard principles entry (T4), added when FAIR,
//    CARE, TRUST and POSI were retyped to `concept`; it relates to `fair`
//    and is developed by `force11`, so it connects into the set.
const { locale } = Astro.params as { locale: LocaleCode };

const CORE_ENTITY_IDS = [
  'doi',
  'orcid',
  'ror',
  'handle-system',
  'crossref',
  'datacite',
  'scopus',
  'web-of-science',
  'openalex',
  'dimensions',
  'zenodo',
  'dataverse',
  'dspace',
  'symplectic-elements',
  'figshare',
  'elsevier',
  'relx',
  'clarivate',
  'digital-science',
  'holtzbrinck',
  'fair',
  'coar',
  'posi',
  'datacite-metadata-schema',
  'unesco-recommendation-open-science',
  'coar-notify',
  'oai-pmh',
  'dona-foundation',
  'international-doi-foundation',
  'force11',
  'ourresearch',
  'trust-principles',
  'coretrustseal',
  'fair4rs',
] as const;

const fullLinkCopy = { es: '← Ver el mapa completo', en: '← See the full map' } as const;
---

<MapExplorerV2 locale={locale} entityIds={CORE_ENTITY_IDS} crossLinkHref={`/${locale}/map/`} crossLinkLabel={fullLinkCopy[locale]} />
