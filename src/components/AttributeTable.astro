---
// The Technical-level complete attribute table (specs.md §5.2, §7.1). One
// row per EntityBase/subtype field actually present on this entity — no
// blank rows for fields the entity doesn't have.
import type { Entity } from '../lib/model/types.js';

export interface Props {
  entity: Entity;
}

const { entity } = Astro.props;

const HIDDEN = new Set(['id', 'relations', 'sources']); // shown elsewhere on the page, not repeated here (§7.1 "no fact appears at two levels")

function formatValue(value: unknown): string {
  if (value == null) return '—';
  if (Array.isArray(value)) return value.length ? value.join(', ') : '—';
  if (typeof value === 'boolean') return value ? 'yes' : 'no';
  return String(value);
}

const rows = Object.entries(entity)
  .filter(([key, value]) => !HIDDEN.has(key) && value !== undefined)
  .map(([key, value]) => [key, formatValue(value)] as const);
---

<table class="attribute-table">
  <caption class="visually-hidden">Complete attributes of {entity.name}</caption>
  <tbody>
    {
      rows.map(([key, value]) => (
        <tr>
          <th scope="row">{key}</th>
          <td>{value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .attribute-table {
    width: 100%;
    border-collapse: collapse;
  }
  .attribute-table th,
  .attribute-table td {
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--border, #d0d7de);
    vertical-align: top;
  }
  .attribute-table th {
    font-weight: 600;
    width: 12rem;
    color: var(--muted-fg, #57606a);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
