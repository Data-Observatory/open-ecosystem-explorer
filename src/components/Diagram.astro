---
// The one accessible-diagram wrapper, reused unchanged by every diagram type
// in every later phase (specs.md §9.1). Markup contract is copied verbatim
// from §9.1 — do not vary it per diagram type; A9.1's Playwright test
// depends on every `<figure class="diagram">` having this exact shape.
import DiagramLegend, { type LegendItem } from './DiagramLegend.astro';
import { getEntityTypesVocab } from '../content/vocab-index.js';
import { TYPE_FILL, shapeForLayer } from '../lib/mermaid/palette.js';
import type { EntityType } from '../lib/model/types.js';
import type { LocaleCode } from '../i18n/locales.js';
import { fmt, getUiStrings } from '../i18n/ui.js';

export interface Props {
  /** Inline <svg>...</svg> markup from renderMermaidToInlineSvg(). */
  svgHtml: string;
  /** <figcaption> text — from describe.ts's DiagramDescription.caption. */
  caption: string;
  /** aria-describedby text — from describe.ts's DiagramDescription.description. */
  description: string;
  /** A9.1/A9.2: the complete, uncollapsed edge table. */
  rows: {
    subjectName: string;
    subjectType: string;
    predicateLabel: string;
    objectName: string;
    objectType: string;
    since?: string;
    note?: string;
  }[];
  /** Stable per-page id prefix so aria-labelledby/describedby don't collide when a page has >1 diagram. */
  idPrefix: string;
  /** Drives the legend's plain-language labels and the pan/zoom buttons' default locale text. */
  locale: LocaleCode;
  tableCaption?: string; // overrides the default localised "View as table (N relationships)" summary
  /** Explicit overrides; otherwise a locale-aware default (see below) is used. */
  zoomInLabel?: string;
  zoomOutLabel?: string;
  resetViewLabel?: string;
}

const { svgHtml, caption, description, rows, idPrefix, locale, tableCaption, zoomInLabel, zoomOutLabel, resetViewLabel } = Astro.props;
const titleId = `${idPrefix}-t`;
const descId = `${idPrefix}-d`;
const svgWrapperId = `${idPrefix}-svg`;
const ui = getUiStrings(locale);
const summary = tableCaption ?? fmt(ui.diagram.tableSummary, { n: rows.length });

const zoomLabels =
  locale === 'es'
    ? { zoomIn: 'Acercar', zoomOut: 'Alejar', reset: 'Restablecer vista' }
    : { zoomIn: 'Zoom in', zoomOut: 'Zoom out', reset: 'Reset view' };
const finalZoomIn = zoomInLabel ?? zoomLabels.zoomIn;
const finalZoomOut = zoomOutLabel ?? zoomLabels.zoomOut;
const finalReset = resetViewLabel ?? zoomLabels.reset;

// Legend: only the types actually present in THIS diagram's table (never all
// 12 on a small focus view) — derived from the same rows the accessible
// table already renders, so it can't drift from what's actually shown.
const typeVocab = await getEntityTypesVocab();
const presentTypes = [...new Set(rows.flatMap((r) => [r.subjectType, r.objectType]))].sort() as EntityType[];
function typeLabel(type: string): string {
  const entry = typeVocab.get(type as EntityType);
  return entry?.label[locale] ?? entry?.label.en ?? type;
}
const legendItems: LegendItem[] = presentTypes
  .filter((t) => typeVocab.has(t))
  .map((t) => {
    const entry = typeVocab.get(t)!;
    return {
      type: t,
      label: entry.label[locale] ?? entry.label.en ?? t,
      layer: entry.layer,
      shape: shapeForLayer(entry.layer),
      fill: TYPE_FILL[t] ?? '#57606a',
    };
  });
---

<figure class="diagram" data-diagram-panzoom>
  <DiagramLegend items={legendItems} locale={locale} />
  <div class="diagram__controls" role="group" aria-label={ui.diagram.controlsLabel}>
    <button type="button" data-panzoom-for={svgWrapperId} data-panzoom-action="zoom-in" aria-label={finalZoomIn}>+</button>
    <button type="button" data-panzoom-for={svgWrapperId} data-panzoom-action="zoom-out" aria-label={finalZoomOut}>&minus;</button>
    <button type="button" data-panzoom-for={svgWrapperId} data-panzoom-action="reset" aria-label={finalReset}>{finalReset}</button>
  </div>
  <div
    id={svgWrapperId}
    class="diagram__svg"
    role="img"
    aria-labelledby={titleId}
    aria-describedby={descId}
    tabindex="0"
    set:html={svgHtml}
  />
  <figcaption id={titleId}>{caption}</figcaption>
  <p id={descId} class="visually-hidden">{description}</p>
  <details class="diagram__data">
    <summary>{summary}</summary>
    <table>
      <caption class="visually-hidden">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">{ui.diagram.colSubject}</th>
          <th scope="col">{ui.diagram.colRelationship}</th>
          <th scope="col">{ui.diagram.colObject}</th>
          <th scope="col">{ui.diagram.colSince}</th>
          <th scope="col">{ui.diagram.colNote}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>
                {row.subjectName} <span class="type-label">({typeLabel(row.subjectType)})</span>
              </td>
              <td>{row.predicateLabel}</td>
              <td>
                {row.objectName} <span class="type-label">({typeLabel(row.objectType)})</span>
              </td>
              <td>{row.since ?? '—'}</td>
              <td>{row.note ?? ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
    max-width: 100%;
  }
  .diagram__controls {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .diagram__controls button {
    font: inherit;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border, #d0d7de);
    border-radius: 4px;
    background: var(--bg, #fff);
    cursor: pointer;
  }
  .diagram__controls button:hover {
    background: var(--muted-bg, #f0f2f4);
  }
  .diagram__controls button:focus-visible {
    outline: 2px solid #1f6feb;
    outline-offset: 2px;
  }
  .diagram__svg {
    overflow: hidden;
    /* Mermaid's default theme assumes a light background and isn't
       re-verified for contrast against a dark page background (§9.2
       1.4.11) — pin diagrams to the light background the palette in
       palette.ts was actually contrast-checked against, independent of
       the page's own color-scheme, rather than shipping an unverified
       dark-mode diagram theme. */
    background: #ffffff;
    padding: 0.5rem;
    border-radius: 4px;
    /* Real dimensions so svg-pan-zoom (2c/Task 2a) has a fixed viewport to
       pan/zoom within; without JS the SVG still renders at this size and
       overflow:hidden degrades to overflow:auto via the [no-js] override
       below so nothing is ever clipped when the enhancement can't run. */
    height: 480px;
  }
  :global(html:not(.js)) .diagram__svg {
    overflow: auto;
    height: auto;
  }
  .diagram__svg :global(svg) {
    max-width: 100%;
    height: auto;
  }
  .diagram__svg[data-panzoom-active] :global(svg) {
    max-width: none;
    height: 100%;
    width: 100%;
  }
  .diagram__svg:focus-visible {
    outline: 2px solid #1f6feb;
    outline-offset: -2px;
  }
  .diagram__data table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
  }
  .diagram__data th,
  .diagram__data td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border, #d0d7de);
  }
  .type-label {
    color: var(--muted-fg, #57606a);
    font-size: 0.85em;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Real pan/zoom (Task A of the interactivity pivot): svg-pan-zoom against
  // every [data-diagram-panzoom] wrapper's inline SVG. Additive only — the
  // SVG's own <a>/click-navigate anchors (from Mermaid's `click` directive)
  // and the html:not(.js) CSS fallback both keep working if this script
  // fails or is blocked (tests/e2e/no-js.spec.ts covers the latter).
  import svgPanZoom from 'svg-pan-zoom';

  function initOne(wrapper: HTMLElement): void {
    const svg = wrapper.querySelector('svg');
    if (!svg) return;
    // Real dimensions are required by svg-pan-zoom; Diagram.astro's CSS
    // gives the wrapper a fixed height (480px) for exactly this reason.
    let instance: ReturnType<typeof svgPanZoom>;
    try {
      instance = svgPanZoom(svg, {
        controlIconsEnabled: false, // we render our own buttons (WCAG 2.5.7 keyboard/button equivalents)
        fit: true,
        center: true,
        minZoom: 0.5,
        maxZoom: 8,
        zoomScaleSensitivity: 0.3,
        // svg-pan-zoom already distinguishes a click from a drag by
        // movement threshold, so plain clicks on Mermaid's `click`-directive
        // anchors keep navigating normally — verified in Task A's Playwright
        // trace (see report), not merely assumed from the library's docs.
      });
    } catch {
      return; // leave the static SVG as-is; nothing to enhance, nothing broken
    }
    wrapper.setAttribute('data-panzoom-active', '');

    const step = 60; // px, for both button-driven and keyboard panning
    const zoomStep = 0.3;

    for (const btn of wrapper.parentElement!.querySelectorAll<HTMLButtonElement>('[data-panzoom-for]')) {
      if (btn.getAttribute('data-panzoom-for') !== wrapper.id) continue;
      const action = btn.getAttribute('data-panzoom-action');
      btn.addEventListener('click', () => {
        if (action === 'zoom-in') instance.zoomBy(1 + zoomStep);
        else if (action === 'zoom-out') instance.zoomBy(1 / (1 + zoomStep));
        else if (action === 'reset') {
          instance.resetZoom();
          instance.fit();
          instance.center();
        }
      });
    }

    // WCAG 2.5.7: dragging must never be the only way to pan. Arrow keys pan,
    // +/-/0 zoom/reset, whenever the wrapper (tabindex="0") has focus.
    wrapper.addEventListener('keydown', (e) => {
      switch (e.key) {
        case 'ArrowUp':
          instance.panBy({ x: 0, y: step });
          break;
        case 'ArrowDown':
          instance.panBy({ x: 0, y: -step });
          break;
        case 'ArrowLeft':
          instance.panBy({ x: step, y: 0 });
          break;
        case 'ArrowRight':
          instance.panBy({ x: -step, y: 0 });
          break;
        case '+':
        case '=':
          instance.zoomBy(1 + zoomStep);
          break;
        case '-':
        case '_':
          instance.zoomBy(1 / (1 + zoomStep));
          break;
        case '0':
          instance.resetZoom();
          instance.fit();
          instance.center();
          break;
        default:
          return; // don't swallow other keys (e.g. Tab)
      }
      e.preventDefault();
    });
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>('[data-diagram-panzoom] > [id$="-svg"]').forEach(initOne);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>
