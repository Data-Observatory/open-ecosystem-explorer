    @media (max-width: 900px) {
      .map2-body,
      .map2-body[data-collapsed~='layers'],
      .map2-body[data-collapsed~='inspector'] {
        grid-template-columns: 1fr;
        grid-template-rows: auto minmax(280px, 1fr) auto;
        grid-template-areas: 'layers' 'canvas' 'inspector';
      }
      .map2-layers,
      .map2-inspector {
        max-height: 30vh;
      }
    }
  </style>

  <script>
    import cytoscape from 'cytoscape';
    // Isolate-mode re-layout (2026-09-09 follow-up: "'aislar' works
    // perfectly, but I would like to re-arrange also, so I can reduce long
    // distances") — `cytoscape-fcose` is already a real dependency
    // (package.json), used previously only by the now-removed
    // `MapExplorer.astro`; registered here fresh for this file's own use
    // below (`enterIsolate`/`applyIsolate`). Must be registered via
    // `cytoscape.use()` before any `layout: { name: 'fcose', ... }` call —
    // done once, at module init, same as any other Cytoscape extension.
    import fcose from 'cytoscape-fcose';
    cytoscape.use(fcose);
    import { LAYER_ORDER } from '../lib/mermaid/layers.js';
    import { scoreSearchEntry } from '../lib/map/search-score.js';
    import { classifyNodes, summarizeStates, nHopNeighborhood, type Adjacency } from '../lib/map/graph-state.js';
    import {
      computeLayout,
      computeTier,
      DEFAULT_LAYOUT_OPTIONS,
      LABEL_FONT_SIZE,
      LABEL_INSET_MARGIN,
      TIER_PADDING,
      CLUSTER_PADDING,
      TIER_LABEL_GUTTER,
      TIER_LABEL_OUTSET_GAP,
      estimateLabelWidth,
    } from '../lib/map/hierarchy.js';
    import { classBoxDataUri, classBoxHeight, CLASS_BOX_WIDTH } from '../lib/map/node-svg.js';
    import { matchesFacets, type FacetableNode, type FacetFilters } from '../lib/map/facets.js';
    import { parseMapUrlState, serializeMapUrlState, type MapUrlState } from '../lib/map/url-state.js';

    interface RelationRef {
      predicate: string;
      predicateLabel: string;
      id: string;
      name: string;
      note?: string;
      since?: string;
      /** True when `id` is one of this map's curated entities (clickable,
       *  selectable pill); false when the relation is real but its target
       *  isn't on this canvas (rendered as a plain link out instead). Only
       *  set on `MapNode.fullOutgoing`/`fullIncoming` — the canvas-trimmed
       *  `outgoing`/`incoming` never contain an out-of-set id in the first
       *  place, so it's always true there and the field is omitted. */
      inSet?: boolean;
    }
    interface ClassBoxFieldSpec {
      label: string;
      value: string;
    }
    interface SourceRef {
      url: string;
      title?: string;
      accessed: string;
      note?: string;
    }
    interface MapNode {
      id: string;
      type: string;
      typeLabel: string;
      layer: string;
      layerLabel: string;
      subtype?: string;
      subtypeLabel?: string;
      name: string;
      aka?: string[];
      summary: string;
      body: string;
      fallback: boolean;
      governance: string;
      governanceLabel: string;
      region: string;
      regionLabel: string;
      status: string;
      statusLabel: string;
      tags: string[];
      disciplines?: string[];
      geography?: string[];
      lastReviewed: string;
      noRelations: boolean;
      outgoing: RelationRef[];
      incoming: RelationRef[];
      /** Full, uncurated relation lists (real corpus truth, `inSet`-tagged)
       *  — read by the single-selection inspector instead of `outgoing`/
       *  `incoming` above, which stay canvas-trimmed for layout/adjacency. */
      fullOutgoing: RelationRef[];
      fullIncoming: RelationRef[];
      classBoxFields: ClassBoxFieldSpec[];
      sources: SourceRef[];
      extraFields: ClassBoxFieldSpec[];
    }
    interface MapEdge {
      from: string;
      to: string;
      predicate: string;
    }
    interface PanelI18n {
      tooltipType: string;
      tooltipLayer: string;
      tooltipSubtype: string;
      noRelationsBadge: string;
      openFullPageLabel: string;
      fullPageLoadErrorLabel: string;
      loadingFullPageLabel: string;
      clearSelection: string;
      selectionChipsLabel: string;
      sharedLabel: string;
      searchNoResults: string;
      defaultLocale: string;
    }

    function readJson<T>(id: string): T {
      const el = document.getElementById(id);
      return JSON.parse(el?.textContent ?? 'null') as T;
    }
    function showError(): void {
      const err = document.getElementById('map2-error');
      const canvas = document.getElementById('map2-canvas');
      if (err) err.hidden = false;
      if (canvas) (canvas as HTMLElement).style.display = 'none';
    }

    // Below this zoom, render a small dot instead of the full class box —
    // a LEGIBILITY bar (176px-wide class-box text needs roughly this much
    // zoom to read at all, independent of corpus size).
    //
    // History: earlier passes treated this threshold as ALSO having to be
    // the default view's own zoom floor — i.e. "the default view must fit
    // the whole graph AND land above 0.4" — and, once a real container-size
    // race at construction time was fixed (see the ResizeObserver/
    // `resetView` comment below; earlier "fit-zoom" readings had been
    // measured against a container ~35% taller than the one that actually
    // renders), that combination turned out to be mutually exclusive for
    // this corpus's real row count: fitting all 33 nodes/13 tier-depth rows
    // in one view landed at ~0.28-0.30, and no reasonable spacing closed
    // that gap without making boxes touch. That's what the earlier version
    // of this comment called "the honest default is dot mode".
    //
    // That framing is now the wrong one to hold onto: `MIN_DEFAULT_ZOOM`
    // (see `resetView`) decouples the two concerns — it floors the default/
    // reset view's zoom independently of whatever a naive `cy.fit()` would
    // produce, so the default view is legible REGARDLESS of how many rows
    // the corpus has, by panning to see the rest instead of shrinking to
    // fit it all. `LOD_ZOOM_THRESHOLD` now does the one job it was always
    // meant to do: degrade to dots only when the user deliberately zooms
    // OUT past readability (e.g. via the zoom-out button/wheel/keyboard) —
    // not as a description of the default view, which no longer needs to
    // dip below it.
    // (2026-09-08: briefly divided by 3 alongside a Card-size tripling that
    // was reverted — the "triple the text" ask was about Tier/Cluster
    // labels, not Cards. Back to the original threshold.)
    const LOD_ZOOM_THRESHOLD = 0.4;
    const TIER_LABELS: Record<string, Record<number, string>> = {
      es: {
        4: 'Principios y políticas',
        3: 'Estándares y especificaciones',
        2: 'Instituciones y agencias',
        1: 'Instrumentos y sistemas',
      },
      en: {
        4: 'Principles and policies',
        3: 'Standards and specifications',
        2: 'Institutions and agencies',
        1: 'Instruments and systems',
      },
    };
    function tierNodeId(tier: number): string {
      return `__tier-${tier}`;
    }
    /** True for a tier band OR a nested sub-band — every non-entity compound
     *  container, i.e. everything a tap/hover/dim interaction below should
     *  treat as "not a selectable node" the same way. */
    function isBandNode(el: cytoscape.NodeSingular): boolean {
      return el.hasClass('tier-band') || el.hasClass('sub-band');
    }

    function initMap(): void {
      const canvas = document.getElementById('map2-canvas');
      if (!canvas) return;
      const graph = readJson<{ nodes: MapNode[]; edges: MapEdge[] }>('map2-graph-data');
      const style = readJson<{ types: Record<string, { fill: string; shape: string }>; predicates: Record<string, { color: string; line: string }> }>(
        'map2-style-data',
      );
      const i18n = readJson<PanelI18n>('map2-i18n-data');
      if (!graph || !style || !i18n) {
        showError();
        return;
      }

      const locale = document.getElementById('map2-app')?.getAttribute('data-locale') ?? 'en';
      const nodeById = new Map(graph.nodes.map((n) => [n.id, n]));
      const allIds = graph.nodes.map((n) => n.id);

      const outTargets = new Map<string, string[]>();
      const inSources = new Map<string, string[]>();
      for (const e of graph.edges) {
        (outTargets.get(e.from) ?? outTargets.set(e.from, []).get(e.from)!).push(e.to);
        (inSources.get(e.to) ?? inSources.set(e.to, []).get(e.to)!).push(e.from);
      }
      const adjacency: Adjacency = { outTargets, inSources };

      // ---- Hierarchical preset layout: tier+depth ranking -> (x,y). ----
      // Rows are ranked by their dense sorted position among the composite
      // values actually present, not by the raw composite number — see
      // hierarchy.ts's computeLayout doc: using composite (tier*100+depth)
      // directly as a row multiplier bakes in up to 99 empty rows between
      // tiers, which is what made the layout ~20x taller than it needed to
      // be and forced the initial fit to zoom out far below readability.
      // Spacing comes from hierarchy.ts's DEFAULT_LAYOUT_OPTIONS — the single
      // source of truth shared with this module's own overlap tests, so the
      // renderer's row gap can never again silently drift smaller than the
      // class box's actual rendered height (that drift was the previous
      // "cards on top of others" bug).
      const positions = computeLayout(graph.nodes, graph.edges, DEFAULT_LAYOUT_OPTIONS);
      function positionFor(id: string): { x: number; y: number } {
        return positions.get(id) ?? { x: 0, y: 0 };
      }

      // Tier compound bands (report follow-up: "no clear division between
      // roles is present... a zone with the name, a big rectangle, with the
      // entities inside it" — restoring `/map`'s existing layer-band
      // technique, but grouped by this hierarchy's `tier` concept instead of
      // the taxonomy `layer`). Bands are given NO explicit position/size —
      // Cytoscape derives a compound parent's bounding box from its already-
      // positioned children automatically, for any layout including `preset`
      // (this is what let `/map`'s fcose-based bands work without pinning the
      // parent directly, which crashed fcose there; `preset` never touches
      // parents at all, so this is even simpler here — no anchor node needed).
      const tiersPresent = [...new Set(graph.nodes.map((n) => computeTier(n.type, n.subtype)))].sort((a, b) => b - a);
      const parentElements = tiersPresent.map((tier) => ({
        data: { id: tierNodeId(tier), label: TIER_LABELS[locale]?.[tier] ?? `Tier ${tier}` },
        classes: 'tier-band',
      }));

      // ---- Nested sub-bands within tier 1 ("instrumentos y sistemas") and
      // tier 2 ("instituciones y agencias") only (2026-09-08 — the user's
      // original "split into more nodes" ask was about THESE 4 big grey
      // containers, not (as first misread) about spreading entities across
      // more rows within one shared container — that row-separation work
      // stands as a real, necessary prerequisite: each governance/region
      // subgroup now already occupies its own contiguous row(s) thanks to
      // hierarchy.ts's per-type depth de-duplication, so nesting a compound
      // box around exactly those rows here just makes visible what the
      // layout was already doing). T1 splits by `governance`, T2 by region
      // (`hierarchy.ts`'s own `regionOf`, mirrored server-side into each
      // node's precomputed `region`/`regionLabel` fields — see
      // MapExplorerV2.astro's `allNodes` construction — because the label
      // lookup needs `tagsVocab`, only available server-side). T3/T4 keep a
      // single flat band, unchanged: this component was never reported
      // concentrated there.
      function subBandId(tier: number, key: string): string {
        return `__subband-${tier}-${key}`;
      }
      function subBandKeyFor(n: MapNode): string | undefined {
        const tier = computeTier(n.type, n.subtype);
        if (tier === 1) return n.governance;
        if (tier === 2) return n.region;
        return undefined;
      }
      function subBandLabelFor(n: MapNode): string {
        const tier = computeTier(n.type, n.subtype);
        return tier === 1 ? n.governanceLabel : n.regionLabel;
      }
      const subBandsSeen = new Map<string, { tier: number; label: string }>();
      for (const n of graph.nodes) {
        const key = subBandKeyFor(n);
        if (key === undefined) continue;
        const tier = computeTier(n.type, n.subtype);
        const id = subBandId(tier, key);
        if (!subBandsSeen.has(id)) subBandsSeen.set(id, { tier, label: subBandLabelFor(n) });
      }
      const subBandElements = [...subBandsSeen.entries()].map(([id, { tier, label }]) => ({
        data: { id, label, parent: tierNodeId(tier) },
        // `sub-band` only, deliberately NOT also `tier-band` (a first pass
        // gave it both, to reuse every `.tier-band`-scoped interaction check
        // below for free — reverted: it also made `.tier-band` ambiguous
        // wherever code actually means "the 4 outer bands specifically", e.g.
        // an existing test asserting exactly 4 `.tier-band` nodes started
        // seeing 10. `.tier-band` now means only the 4 outer bands again;
        // every interaction check below that needs to treat a sub-band the
        // same way explicitly says so with `.sub-band` too.
        classes: 'sub-band',
      }));
      function parentFor(n: MapNode): string {
        const key = subBandKeyFor(n);
        return key === undefined ? tierNodeId(computeTier(n.type, n.subtype)) : subBandId(computeTier(n.type, n.subtype), key);
      }

      let cy: cytoscape.Core;
      try {
        cy = cytoscape({
          container: canvas,
          elements: [
            ...parentElements,
            ...subBandElements,
            ...graph.nodes.map((n) => ({
              data: {
                id: n.id,
                label: n.name,
                type: n.type,
                typeLabel: n.typeLabel,
                layer: n.layer,
                layerLabel: n.layerLabel,
                subtype: n.subtype,
                subtypeLabel: n.subtypeLabel,
                summary: n.summary,
                parent: parentFor(n),
              },
              position: positionFor(n.id),
            })),
            ...graph.edges.map((e, i) => ({ data: { id: `e${i}`, source: e.from, target: e.to, predicate: e.predicate } })),
          ],
          style: [
            {
              // Compound tier-band parents only — kept off the plain 'node'
              // selector so a band's look (light fill, top-left label) never
              // has to fight the per-type colour/shape styling below, and so
              // Cytoscape's automatic compound-parent sizing (which ignores
              // any explicit width/height style anyway) isn't shadowed by it.
              selector: 'node.tier-band',
              style: {
                'background-color': '#f6f8fa',
                'background-opacity': 0.6,
                'border-width': 2,
                'border-color': '#8c959f',
                shape: 'round-rectangle',
                label: 'data(label)',
                // Unified with Cluster's own label size (`LABEL_FONT_SIZE`,
                // hierarchy.ts) — 2026-09-09 follow-up, explicit ask: "both
                // with the same text size" (was 36 here / 45 for Cluster).
                'font-size': LABEL_FONT_SIZE,
                'font-weight': 700,
                color: '#3d444d',
                // Top-left, ABOVE the border (2026-09-09 follow-up ROUND 2 —
                // a direct reversal of the immediately-preceding round: user
                // confirmed Cluster titles [below] are fine as-is, but for
                // Tier specifically: "I want the title to start on the
                // beginning of the box (left side), not ending there like is
                // right now. And above the box"). Two axes, two separate
                // empirically-verified fixes (a standalone Playwright/
                // Cytoscape harness measuring `renderedBoundingBox` with vs.
                // without labels — see hierarchy.ts's `TIER_LABEL_GUTTER`/
                // `TIER_LABEL_OUTSET_GAP` comments):
                //
                // VERTICAL: `text-valign: 'top'` anchors the label's BOTTOM
                // edge at (node top edge + `text-margin-y`) — confirmed a
                // PLAIN `text-margin-y: 0` already puts the label's bottom
                // exactly ON the border, extending upward from there (i.e.
                // "above the box"). The prior round's LARGE POSITIVE margin
                // (`LABEL_INSET_MARGIN`) was deliberately pulling it back
                // DOWN into the box's interior — exactly what's being
                // reversed here. `-TIER_LABEL_OUTSET_GAP` (small, negative)
                // just adds a hair of breathing room so the label doesn't
                // touch the border.
                //
                // HORIZONTAL: `text-halign: 'left'` anchors the label's
                // RIGHT edge at (node left edge + `text-margin-x`), extending
                // LEFTWARD (outward) from there — confirmed empirically: a
                // small flat `text-margin-x` (the prior round's `10`) is
                // nowhere near enough to counter this for a real label, which
                // is why the title visibly sat OUTSIDE to the left instead of
                // starting flush at the border and growing right. Since text
                // WIDTH varies per label ("Comunitaria" vs. "Principios y
                // políticas"), a single fixed margin can't fix this for every
                // label the way the vertical fix could — this needs a
                // DYNAMIC per-node margin equal to (this label's own
                // estimated rendered width) + a small gutter, so the label's
                // RIGHT edge lands just past its own LEFT edge sitting at the
                // border, i.e. the label ends up occupying the border-to-
                // (border+width) span instead of (border-width)-to-border.
                'text-valign': 'top',
                'text-halign': 'left',
                'text-margin-y': -TIER_LABEL_OUTSET_GAP,
                'text-margin-x': (el: cytoscape.NodeSingular) => estimateLabelWidth(el.data('label') ?? '', LABEL_FONT_SIZE) + TIER_LABEL_GUTTER,
                // Small, label-INDEPENDENT gutter now (hierarchy.ts's
                // `TIER_PADDING`) — the label lives OUTSIDE the border again,
                // so this box no longer needs interior room reserved for it
                // (see hierarchy.ts's `LABEL_CLEARANCE`, which now reserves
                // that room EXTERNALLY, between stacked Tier boxes, instead).
                padding: `${TIER_PADDING}px`,
                // A small background chip behind the label text: the label
                // now sits inside the box, directly above wherever its first
                // nested Cluster/Card row begins — a chip keeps it legible
                // even if a Cluster's own (differently-coloured) fill or
                // border happens to touch this corner.
                'text-background-color': '#f6f8fa',
                'text-background-opacity': 0.9,
                'text-background-padding': '3px',
                'text-background-shape': 'roundrectangle',
              },
            },
            {
              // Nested sub-bands (governance within T1, region within T2) —
              // a separate `.sub-band` class, not also `.tier-band` (see the
              // classes comment where these are created), so this rule
              // repeats the base compound-box properties (shape/label/text
              // position/padding) rather than relying on selector fallthrough
              // from `node.tier-band` above, plus its own distinguishable
              // "nested inside" look.
              selector: 'node.sub-band',
              style: {
                shape: 'round-rectangle',
                label: 'data(label)',
                // Top-CENTER, inside the border (2026-09-09 follow-up:
                // Cluster titles "on top of the box, centered" — unlike
                // Tier's top-LEFT). `text-margin-x: 0` since a centered
                // label needs no horizontal nudge; same
                // `text-margin-y`/`padding` inside-the-border mechanism as
                // `node.tier-band` above (see that rule's comment).
                'text-valign': 'top',
                'text-halign': 'center',
                'text-margin-y': LABEL_INSET_MARGIN,
                'text-margin-x': 0,
                padding: `${CLUSTER_PADDING}px`,
                // Two earlier passes here were still reported as invisible
                // ("I cant see shit") despite each being verified via a
                // screenshot — first near-white/1px/10px, then #eef2ff
                // fill/2px border/15px label. Pushed much further this time:
                // a visibly tinted, more saturated fill (not just a shade off
                // the tier-band's own near-white), a thick 4px border in a
                // strongly contrasting hue, and a bold label sharing Tier's
                // own `LABEL_FONT_SIZE` (2026-09-09: unified from a separate,
                // larger 45px) — this needs to read as an obviously distinct
                // nested box at a glance, not on close inspection.
                'background-color': '#dbe4ff',
                'background-opacity': 1,
                'border-width': 4,
                'border-color': '#3949ab',
                'border-style': 'solid',
                'font-size': LABEL_FONT_SIZE,
                'font-weight': 700,
                color: '#1a237e',
                'text-background-color': '#dbe4ff',
                'text-background-opacity': 0.9,
                'text-background-padding': '3px',
                'text-background-shape': 'roundrectangle',
              },
            },
            {
              selector: 'node:childless',
              style: {
                label: 'data(label)',
                'font-size': 9,
                'text-valign': 'bottom',
                'text-margin-y': 3,
                width: 14,
                height: 14,
                color: '#1f2328',
                'background-color': (el: cytoscape.NodeSingular) => style.types[el.data('type')]?.fill ?? '#57606a',
                shape: (el: cytoscape.NodeSingular) => (style.types[el.data('type')]?.shape ?? 'ellipse') as cytoscape.Css.NodeShape,
                'border-width': 1.5,
                'border-color': '#1f2328',
                'background-fit': 'none',
              },
            },
            {
              selector: 'edge',
              style: {
                width: (el: cytoscape.EdgeSingular) => (style.predicates[el.data('predicate')]?.line === 'thick' ? 3 : 1.2),
                'curve-style': 'bezier',
                'target-arrow-shape': 'triangle',
                'arrow-scale': 0.7,
                'line-color': (el: cytoscape.EdgeSingular) => style.predicates[el.data('predicate')]?.color ?? '#57606a',
                'target-arrow-color': (el: cytoscape.EdgeSingular) => style.predicates[el.data('predicate')]?.color ?? '#57606a',
                'line-style': (el: cytoscape.EdgeSingular) =>
                  (style.predicates[el.data('predicate')]?.line === 'dashed' ? 'dashed' : 'solid') as cytoscape.Css.LineStyle,
                opacity: 0.85,
              },
            },
            { selector: '.dimmed', style: { opacity: 0.12 } },
            { selector: '.highlighted', style: { opacity: 1, 'z-index': 999 } },
            // Border bump on top of the opacity difference: verified the
            // hover logic itself is correct (reproduced directly — the
            // right node gets `.highlighted`, the rest get `.dimmed`, at
            // every zoom level, including dot mode) but opacity 1 vs 0.12 on
            // a 14x14 dot renders ~4 real screen pixels apart, which is
            // effectively imperceptible — this makes the hovered node/its
            // neighbours stand out by outline as well as by fade, so the
            // state reads clearly even at the smallest LOD.
            { selector: 'node.highlighted', style: { 'border-width': 2.5, 'border-color': '#1f2328' } },
            { selector: 'node.state-selected', style: { 'border-color': '#d4380d', 'border-width': 3 } },
            { selector: 'node.state-upstream', style: { 'border-color': '#1f6feb', 'border-width': 2.5 } },
            { selector: 'node.state-downstream', style: { 'border-color': '#1a7f37', 'border-width': 2.5 } },
            { selector: 'node.state-shared', style: { 'border-color': '#8250df', 'border-width': 3 } },
            { selector: 'node.state-dimmed', style: { opacity: 0.35 } },
            { selector: 'edge.state-dimmed', style: { opacity: 0.06 } },
            // Focus mode + facet filtering (`/map`-only, `showAdvanced`) —
            // promoted from `MapExplorer.astro`.
            { selector: 'node.focus-dimmed', style: { opacity: 0.15 } },
            { selector: 'edge.focus-dimmed', style: { opacity: 0.06 } },
            // "Aislar" (2026-09-09 follow-up) — HARD hide, not dim: unlike
            // `.focus-dimmed` above, an isolated-out element is removed from
            // the render entirely (`display:none`) rather than faded. Also
            // applied to a Tier/Cluster band once every one of its children
            // is isolated-out (see `applyIsolate`) — an empty grey box would
            // otherwise still render and defeat the point of isolating.
            { selector: 'node.isolated-hidden', style: { display: 'none' } },
            { selector: 'edge.isolated-hidden', style: { display: 'none' } },
            { selector: 'node.filtered-out', style: { opacity: 0.08 } },
            // Class-box LOD: applied once the layout has an initial zoom
            // (see fitAndClassify below), toggled again on every zoom change.
            {
              selector: 'node.classbox',
              style: {
                shape: 'round-rectangle',
                'background-fit': 'contain',
                'background-clip': 'none',
                'border-width': 1,
                // The class-box SVG already draws the name in its own title
                // bar — an additional Cytoscape label here would float a
                // second copy of the name above the box.
                label: '',
              },
            },
          ],
          layout: { name: 'preset', fit: true, padding: 40 },
          minZoom: 0.1,
          maxZoom: 6,
          wheelSensitivity: 1,
          // Real-canvas multi-select bug fix (user: "i cannot select more
          // than 1 box") — root-caused via Cytoscape's own interaction
          // source (node_modules/cytoscape/dist/cytoscape.cjs.js), not
          // guessed, and confirmed live with a real Playwright mouse
          // gesture (mousedown -> a few px of movement -> mouseup, the same
          // small jitter any real mouse/trackpad click has) before this fix
          // existed: a synthetic `.click()`/`cy.emit('tap')` never moves the
          // pointer at all, so every EXISTING test here (including the
          // "multi-selection" ones) hit zero pixels of movement and always
          // passed — they exercised the Layers-panel `<button>` elements or
          // direct Cytoscape event emission, never a real canvas drag
          // gesture, so this gap was invisible to them.
          //
          // Cytoscape's own default `boxSelectionEnabled: true`, combined
          // with its default `desktopTapThreshold` of 4px, means: the
          // instant a mousedown-on-a-node -> mouseup gesture moves the
          // pointer more than ~4px (`isOverThresholdDrag`), Cytoscape STOPS
          // treating it as a candidate tap. If a multi-select modifier
          // (shift/ctrl/meta) is held at that moment, it reinterprets the
          // whole gesture as an additive BOX-SELECTION drag instead
          // (`goIntoBoxMode()`, gated on exactly `boxSelectionEnabled() &&
          // multSelKeyDown`) rather than firing 'tap' on the node — so this
          // file's own `cy.on('tap', 'node', ...)` handler (which reads
          // `evt.originalEvent.shiftKey/metaKey/ctrlKey` to call
          // `toggleSelection(id, {additive: true})`) never runs at all.
          // Reproduced directly: the box-selection region this opens
          // typically ends up empty/over background, and Cytoscape's
          // mouseup handler then also fires a plain 'tap' on the CORE
          // (target === cy) for that empty-background release — which this
          // file's OWN `cy.on('tap', (evt) => { if (evt.target === cy)
          // selected.clear() ... })` handler (added for "click empty canvas
          // to deselect") interprets as "clear the whole selection". Net
          // observed effect matches the report exactly: not just "the
          // second card doesn't get added" but "the existing selection gets
          // wiped" on the very click meant to extend it.
          //
          // This app never uses Cytoscape's own native box-selection or
          // `.selected()`/`.select()`/`.unselect()` API (verified: zero
          // references anywhere in this file) — the ENTIRE selection model
          // is this file's own `selected` Set, driven purely by 'tap'
          // events. Native box-select has no job to do here and is the
          // direct cause of the bug, so it's simply turned off.
          // `desktopTapThreshold` is also raised from Cytoscape's default 4
          // to 12 — turning boxSelectionEnabled off alone would just make
          // the same over-threshold gesture fall into the NEXT branch
          // instead (dragging the grabbable node a few px, which ALSO
          // suppresses 'tap' via the same `isOverThresholdDrag` gate on
          // mouseup) — a real click (with or without a modifier) needs
          // enough slack to stay a tap despite ordinary mouse/trackpad
          // jitter. 12px comfortably absorbs that jitter while staying far
          // below the 60px+ move the existing "a node can still be dragged"
          // regression test performs, so deliberate node-dragging keeps
          // working unchanged.
          boxSelectionEnabled: false,
          desktopTapThreshold: 12,
        });
      } catch {
        showError();
        return;
      }

      (window as unknown as { __cyMap2?: cytoscape.Core }).__cyMap2 = cy;

      // ---- Zoom-dependent level of detail: dot below threshold, full
      // class-box (background-image SVG data URI, sized to its content)
      // above it — report §B5's "don't render fields on every node at every
      // zoom, that's how ER tools stay usable at both scales". ----
      // Two separate concerns, deliberately kept in two separate caches:
      //
      // `classBoxCache` holds the expensive-to-generate SVG data URI + box
      // height per node — generated once, since it's deterministic for a
      // given node's data.
      //
      // `boxApplied` tracks whether the CURRENT Cytoscape node style is
      // already in "class-box" state, so the actual `n.style(...)` mutation
      // below only runs on a real LOD *transition* (dot -> box or box -> dot),
      // never redundantly on every 'zoom' event tick. This distinction fixes
      // two bugs that came from conflating it into one guard:
      //
      // 1. An earlier version gated the width/height/background-image
      //    application behind the SAME "already generated" check as the SVG
      //    string itself. After the FIRST zoom-out (which inline-sets
      //    width/height to the 14x14 dot size) a later zoom back in never
      //    restored width/height to the box size — only re-added the
      //    `.classbox` class — leaving the 176px-wide class-box image
      //    squeezed into a 14x14 box via `background-fit: contain`, with
      //    every baked-in text row scaled down to sub-pixel illegibility.
      //    That was the "works fine until you pan/zoom, then text is
      //    unreadable" bug.
      // 2. The straightforward fix for #1 — always re-apply width/height/
      //    background-image whenever `showBoxes` is true, on every 'zoom'
      //    event — reintroduced a much worse problem: Cytoscape's 'zoom'
      //    event fires continuously (many times per second during a mouse-
      //    wheel or drag-zoom gesture), so re-assigning ~20+ base64 SVG
      //    data-URI backgrounds on every single tick overloads the renderer
      //    and reliably CRASHES the tab under software rasterization
      //    (reproduced consistently in headless Chromium here). Only
      //    touching a node's style when it actually crosses the LOD
      //    threshold — tracked by `boxApplied` — fixes the illegibility bug
      //    without paying that cost on every zoom tick.
      const classBoxCache = new Map<string, { uri: string; height: number }>();
      const boxApplied = new Set<string>();
      function applyLod(): void {
        const z = cy.zoom();
        const showBoxes = z >= LOD_ZOOM_THRESHOLD;
        cy.nodes().forEach((n) => {
          const id = n.id();
          if (!showBoxes) {
            if (boxApplied.has(id)) {
              n.removeClass('classbox');
              n.style({ width: 14, height: 14 });
              boxApplied.delete(id);
            }
            return;
          }
          if (boxApplied.has(id)) return; // already in class-box state — nothing to do this tick
          const node = nodeById.get(id);
          if (!node) return;
          let entry = classBoxCache.get(id);
          if (!entry) {
            const height = classBoxHeight(node.classBoxFields.length);
            const uri = classBoxDataUri({
              name: node.name,
              stereotype: node.subtypeLabel ? `${node.typeLabel} · ${node.subtypeLabel}` : node.typeLabel,
              fill: style.types[node.type]?.fill ?? '#57606a',
              fields: node.classBoxFields,
            });
            entry = { uri, height };
            classBoxCache.set(id, entry);
          }
          n.style({ 'background-image': entry.uri, width: CLASS_BOX_WIDTH, height: entry.height });
          n.addClass('classbox');
          boxApplied.add(id);
        });
      }
      // `applyLod` is never called directly from the 'zoom' event handler.
      // Cytoscape dispatches 'zoom' SYNCHRONOUSLY from inside its own
      // zoom-setting/render code; running style-mutating logic (touching up
      // to ~20+ nodes' width/height/background-image) reentrantly on that
      // same call stack reliably crashed the tab under this environment's
      // software rasterizer (reproduced consistently — every single call to
      // `cy.zoom(level)`, even changing nothing else, crashed the renderer
      // once inside `applyLod`'s per-node `n.style(...)` calls). Deferring
      // the actual work to the next animation frame — and coalescing any
      // zoom events that fire before that frame runs into a single
      // `applyLod()` call — fixes both the crash (mutation happens outside
      // Cytoscape's own dispatch) and, as a side benefit, avoids redundant
      // work during a fast wheel/drag-zoom gesture that fires 'zoom' many
      // times per second.
      let lodFrameScheduled = false;
      function scheduleApplyLod(): void {
        if (lodFrameScheduled) return;
        lodFrameScheduled = true;
        requestAnimationFrame(() => {
          lodFrameScheduled = false;
          applyLod();
        });
      }
      cy.on('zoom', scheduleApplyLod);
      applyLod();

      // ---- ResizeObserver: keep Cytoscape's renderer in sync with its
      // container's real size (report §A2 — collapsing a panel used to
      // widen the canvas div without Cytoscape ever finding out), AND fix a
      // real container-size race at construction time. Traced directly
      // (console logging every zoom/bbox transition, not guessed): at the
      // exact moment `cytoscape({...})` runs, `cy.height()` read 574 —
      // taller than the container's true, final, settled height (424,
      // confirmed identical both immediately after and well after load).
      // The `layout: { fit: true, padding: 40 }` option computed its
      // zoom/pan against that too-tall 574 reading, so on a corpus dense
      // enough to need most of the canvas (33 entities/13 tier-depth rows,
      // after the 2026-09-06 hierarchy expansion), the resulting zoom left
      // real content — e.g. the T1 row DOI sits in — rendered below the
      // container's ACTUAL bottom edge (`document.elementFromPoint` at
      // that node's own `renderedPosition()` returned null: nothing there,
      // because "there" was past `cy.height()`). Re-fitting from inside a
      // `requestAnimationFrame` did NOT fix it — the 574 reading was not a
      // one-frame-stale style question, it settled to 424 within the same
      // synchronous script block that follows (before this ResizeObserver
      // is even attached), so any fit computed off `cy`'s own internal
      // container reference before that settles inherits the same bad
      // number. A `ResizeObserver` callback is guaranteed by spec to fire
      // once immediately upon `.observe()` with the container's CURRENT
      // real size — traced to confirm that first callback already reports
      // 424, the correct value — so doing the one-time initial fit from
      // inside it (not at construction, not in a bare rAF) is what actually
      // closes the gap. Only that FIRST callback re-fits (via
      // `initialFitDone`) so a later resize (e.g. a user collapsing a side
      // panel) still only resizes the renderer, not silently resetting a
      // pan/zoom the user may have already adjusted.
      // MIN_DEFAULT_ZOOM (follow-up, 2026-09-07): a naive `cy.fit()` shrinks
      // to whatever zoom shows the ENTIRE graph at once — for this corpus's
      // real row count (and the larger real gutters the SAME follow-up
      // added between boxes — see hierarchy.ts's DEFAULT_LAYOUT_OPTIONS)
      // that measures at ~0.21, well below LOD_ZOOM_THRESHOLD (0.4), so the
      // graph opened in dot mode by default. That's not just an aesthetic
      // complaint: at that zoom, a 14x14 dot renders at ~3 real screen
      // pixels, and the hover-highlight state (opacity 1 vs 0.12 — see
      // `highlight()` below) is functionally invisible on something that
      // small regardless of whether the underlying logic is correct (it
      // is — verified directly: the right classes/opacity ARE applied at
      // that zoom, they're just imperceptible at 3px).
      //
      // The floor is deliberately set just ABOVE LOD_ZOOM_THRESHOLD (0.45,
      // not e.g. 0.75) rather than at "whatever shows every box
      // comfortably" — measured directly (not assumed): 0.4-0.5 all show
      // the same ~16 of 33 nodes at this canvas's real size, while pushing
      // the floor up to 0.75 drops that to ~5 of 33. A floor exists to fix
      // the ONE concrete legibility problem (dots too small to read
      // hover/selection state), not to maximise zoom for its own sake —
      // picking the smallest floor that still clears the LOD bar keeps as
      // much of the graph visible without panning as the legibility fix
      // allows. `cy.fit()` still runs first so the floor is applied AROUND
      // the graph's own centre (via the same viewport-centre
      // `renderedPosition` `zoom({level,...})` uses elsewhere in this file
      // for search/entity-select centring), not an arbitrary corner.
      // (2026-09-08: briefly divided by 3 alongside the Card-size tripling
      // that was reverted — see `LOD_ZOOM_THRESHOLD`. Back to 0.45.)
      const MIN_DEFAULT_ZOOM = 0.45;
      function resetView(): void {
        cy.fit(undefined, 40);
        if (cy.zoom() < MIN_DEFAULT_ZOOM) {
          cy.zoom({ level: MIN_DEFAULT_ZOOM, renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 } });
        }
      }

      let initialFitDone = false;
      const resizeObserver = new ResizeObserver(() => {
        cy.resize();
        if (!initialFitDone) {
          initialFitDone = true;
          resetView();
        }
      });
      resizeObserver.observe(canvas);

      // ---- Selection state (multi-select, click toggles membership). ----
      const selected = new Set<string>();
      const statusEl = document.getElementById('map2-status');
      const stateKey = document.getElementById('map2-state-key');
      const inspectorContent = document.getElementById('map2-inspector-content');
      // Advanced (`/map`-only, `showAdvanced`) — absent from the DOM on
      // `/map2` (no `showAdvanced` prop there), so these are null and every
      // `?.`-guarded usage below no-ops correctly with zero `/map2` behaviour
      // change. Promoted from `MapExplorer.astro`.
      const focusControls = document.getElementById('map2-focus-controls');
      const hopsSelect = document.getElementById('map2-hops') as HTMLSelectElement | null;
      // Generic focus toggle (both `/map` and `/map2` — see the HTML above
      // for why this is a separate pair of elements from `focusControls`/
      // `hopsSelect`).
      const focusToggleBtn = document.getElementById('map2-focus-toggle') as HTMLButtonElement | null;
      const focusExitBtn = document.getElementById('map2-focus-exit') as HTMLButtonElement | null;
      // "Aislar" — same selection input as Focus, shares `focusExitBtn` as
      // its own exit affordance (see the wiring below).
      const isolateToggleBtn = document.getElementById('map2-isolate-toggle') as HTMLButtonElement | null;

      // Relation links inside the fetched/injected full-page content are
      // real `<a href="/${locale}/entity/${id}/">` anchors from the
      // standalone page — clicked as-is, they'd navigate the whole browser
      // away from /map2, losing the map entirely (user: "we lose the
      // buttons you implemented" — the old hand-built relation pills called
      // toggleSelection() instead of navigating). One delegated listener on
      // the stable container (its innerHTML is replaced wholesale on every
      // selection, so a per-anchor listener would need re-attaching every
      // time) intercepts same-locale entity links and redirects them into a
      // canvas selection instead of a real navigation. Anything else — an
      // external source URL, the raw-JSON link, a different-locale link —
      // isn't an entity-page link at all and falls through to its normal
      // behaviour untouched.
      const ENTITY_LINK_RE = new RegExp(`^/${locale}/entity/([^/]+)/?$`);
      inspectorContent?.addEventListener('click', (evt) => {
        const anchor = (evt.target as HTMLElement).closest('a');
        if (!anchor || !inspectorContent.contains(anchor)) return;
        let path: string;
        try {
          path = new URL(anchor.href, window.location.origin).pathname;
        } catch {
          return;
        }
        const match = ENTITY_LINK_RE.exec(path);
        if (!match) return; // not a same-locale entity link — real navigation/new-tab stays untouched
        evt.preventDefault();
        const targetId = decodeURIComponent(match[1]!);
        if (!nodeById.has(targetId)) {
          // A real relation to an entity outside the curated /map2 set has
          // no node to select — let it navigate normally rather than
          // silently doing nothing.
          window.location.href = anchor.href;
          return;
        }
        toggleSelection(targetId, { additive: false });
        cy.animate({ center: { eles: cy.$id(targetId) }, zoom: Math.max(cy.zoom(), 1) }, { duration: 200 });
      });

      // Heading levels in the fetched full-page fragment (h1/h2) are correct
      // for a standalone document but would be a second, competing h1 once
      // injected under this pane's own `<h2>{t.inspectorTitle}</h2>` — demote
      // each by one level (h1->h2, h2->h3, h3->h4) so the injected content
      // nests correctly instead of skipping/duplicating levels (axe-core
      // heading-order).
      function demoteHeadings(root: HTMLElement): void {
        for (const level of [3, 2, 1]) {
          for (const el of Array.from(root.querySelectorAll(`h${level}`))) {
            const replacement = document.createElement(`h${level + 1}`);
            replacement.innerHTML = el.innerHTML;
            for (const attr of Array.from(el.attributes)) replacement.setAttribute(attr.name, attr.value);
            el.replaceWith(replacement);
          }
        }
      }

      // Guards against a stale fetch clobbering a newer selection's content:
      // bumped on every call to renderSingleInspector, captured locally by
      // the in-flight fetch, and checked before injecting — if the user has
      // since selected a different node, `requestId` no longer matches
      // `inspectorRequestId` and the stale result is dropped.
      let inspectorRequestId = 0;

      // The user asked, repeatedly and explicitly, for the full record to
      // appear directly when a node is selected — no button, no separate
      // compact-summary step, no new tab ("is not so hard to understand"; "why
      // is not displayed directly?"). Fetches the real standalone
      // `/${locale}/entity/${id}/` page (same origin, pre-rendered static
      // HTML) and injects its `<article class="entity-page">` content
      // straight into the pane. This also structurally guarantees content
      // parity with the full page (same markup, fetched live) instead of a
      // second hand-maintained summary that can drift out of sync.
      function renderSingleInspector(node: MapNode): void {
        if (!inspectorContent) return;
        const requestId = ++inspectorRequestId;
        inspectorContent.innerHTML = '';

        const status = document.createElement('p');
        status.className = 'map2-inspector-fullpage-status';
        status.setAttribute('role', 'status');
        status.textContent = `${i18n.loadingFullPageLabel} — ${node.name}`;
        inspectorContent.appendChild(status);

        void loadFullPageInto(node, requestId, status);
      }

      async function loadFullPageInto(node: MapNode, requestId: number, status: HTMLElement): Promise<void> {
        const href = `/${locale}/entity/${node.id}/`;
        try {
          const res = await fetch(href);
          if (!res.ok) throw new Error(`fetch failed: ${res.status}`);
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const article = doc.querySelector('article.entity-page');
          if (!article) throw new Error('article.entity-page not found in fetched page');

          // innerHTML never executes embedded <script> tags — the fetched
          // page's progressive-enhancement script (Standard/Technical
          // <details> persistence) is dropped rather than replayed; the
          // full page's own comment confirms its <details> elements work
          // correctly natively without it.
          for (const script of Array.from(article.querySelectorAll('script'))) script.remove();

          const container = document.createElement('div');
          container.className = 'map2-inspector-fullpage';
          container.innerHTML = article.innerHTML;
          demoteHeadings(container);

          // A newer selection superseded this one, or the pane was torn
          // down/replaced in the meantime — drop the stale result.
          if (requestId !== inspectorRequestId || !status.isConnected) return;
          status.replaceWith(container);
        } catch {
          if (requestId !== inspectorRequestId || !status.isConnected) return;
          status.className = 'map2-inspector-fullpage-status map2-inspector-fullpage-error';
          status.textContent = '';
          const msg = document.createElement('span');
          msg.textContent = i18n.fullPageLoadErrorLabel;
          status.appendChild(msg);
          status.appendChild(document.createTextNode(' '));
          const link = document.createElement('a');
          link.href = href;
          link.textContent = i18n.openFullPageLabel;
          status.appendChild(link);
        }
      }

      function renderMultiInspector(states: Map<string, string>): void {
        if (!inspectorContent) return;
        inspectorContent.innerHTML = '';
        const chips = document.createElement('div');
        chips.className = 'map2-inspector-chips';
        for (const id of selected) {
          const node = nodeById.get(id);
          if (!node) continue;
          const chip = document.createElement('span');
          chip.className = 'map2-inspector-chip';
          const label = document.createElement('span');
          label.textContent = node.name;
          chip.appendChild(label);
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '×';
          remove.setAttribute('aria-label', i18n.clearSelection);
          remove.addEventListener('click', () => toggleSelection(id, { additive: true }));
          chip.appendChild(remove);
          chips.appendChild(chip);
        }
        inspectorContent.appendChild(chips);

        const sharedIds = [...states.entries()].filter(([, s]) => s === 'shared').map(([id]) => id);
        const sharedGroup = document.createElement('div');
        sharedGroup.className = 'map2-relation-group';
        const sharedH = document.createElement('h4');
        sharedH.textContent = `${i18n.sharedLabel} (${sharedIds.length})`;
        sharedGroup.appendChild(sharedH);
        for (const id of sharedIds) {
          const node = nodeById.get(id);
          if (!node) continue;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'map2-relation-pill';
          btn.textContent = node.name;
          btn.addEventListener('click', () => toggleSelection(id, { additive: false }));
          sharedGroup.appendChild(btn);
        }
        inspectorContent.appendChild(sharedGroup);
      }

      function applyStates(): void {
        // Hover-driven `dimmed`/`highlighted` (see `highlight()`/
        // `clearHighlight()` below) and click-driven `state-*` classes are
        // two separate systems that were never reconciled: a real click
        // always starts with the pointer entering the node first, so
        // `highlight()` runs (selected.size is still 0 at that instant),
        // dimming every non-neighbour. The click then adds the node to
        // `selected`, but nothing cleared that leftover `dimmed` class —
        // and once selected.size > 0, `clearHighlight()`'s own guard blocks
        // the mouseout cleanup too, so the dim got stuck permanently
        // (reproduced live: a second selected card carried BOTH
        // `state-selected` and a stale `dimmed`, and opacity 0.12 crushed
        // its colour regardless of the correct border). Clearing both
        // classes unconditionally here, on every call, guarantees a clean
        // slate before the state-* pass below — `highlight()`/
        // `clearHighlight()` already no-op while a selection is active, so
        // nothing re-adds them while selected.size > 0.
        cy.elements().removeClass('dimmed highlighted');
        const states = classifyNodes(allIds, [...selected], adjacency);
        // ':childless' excludes the tier-band compound parents added above —
        // `states` is keyed by real entity ids only (`allIds`), so a band
        // parent would otherwise pick up a bogus `state-undefined` class.
        cy.nodes(':childless').forEach((n) => {
          n.removeClass('state-selected state-upstream state-downstream state-shared state-dimmed');
          if (selected.size > 0) n.addClass(`state-${states.get(n.id())}`);
        });
        cy.edges().forEach((e) => {
          e.removeClass('state-dimmed');
          if (selected.size > 0) {
            const sourceIn = selected.has(e.data('source'));
            const targetIn = selected.has(e.data('target'));
            if (!sourceIn && !targetIn) e.addClass('state-dimmed');
          }
        });

        if (stateKey) stateKey.hidden = selected.size === 0;

        if (selected.size === 0) {
          if (statusEl) statusEl.innerHTML = statusEl.dataset.idleHtml ?? '';
          if (inspectorContent) inspectorContent.innerHTML = '';
          if (focusControls) focusControls.hidden = true;
          // Nothing selected any more -> nothing left to focus on/isolate.
          // Only a REAL exit (turns off `focusActive`/`isolateActive`,
          // restores the default/full camera view) when a mode was actually
          // engaged — a bare `clearFocus()`/`clearIsolate()` when neither
          // was would be a no-op anyway (no element ever got the class),
          // but calling the full `exitFocus()`/`exitIsolate()`
          // unconditionally here would reset pan/zoom on every plain
          // deselect (e.g. clicking empty canvas after just browsing a
          // single card), which is a real UX regression this feature must
          // not introduce.
          if (focusActive) exitFocus();
          else if (isolateActive) exitIsolate();
          else {
            clearFocus();
            clearIsolate();
          }
        } else {
          const { upstream, downstream, shared } = summarizeStates(states);
          if (statusEl) {
            const template = statusEl.dataset.selectionTemplate;
            statusEl.textContent = template
              ? template
                  .replace('{n}', String(selected.size))
                  .replace('{up}', String(upstream))
                  .replace('{down}', String(downstream))
                  .replace('{shared}', String(shared))
              : `${selected.size}`;
          }
          if (selected.size === 1) {
            const node = nodeById.get([...selected][0]!);
            if (node) renderSingleInspector(node);
            if (focusControls) focusControls.hidden = false;
          } else {
            renderMultiInspector(states);
            if (focusControls) focusControls.hidden = true;
          }
          // Selection changed (grew/shrank/swapped) while focus OR isolate
          // mode was already on — recompute which cards/edges stay in scope
          // instead of leaving a stale neighbourhood from the previous
          // selection.
          if (focusActive) applyFocus();
          else if (isolateActive) applyIsolate();
        }

        document.querySelectorAll<HTMLButtonElement>('.map2-entity-btn').forEach((btn) => {
          btn.setAttribute('aria-pressed', selected.has(btn.dataset.selectId ?? '') ? 'true' : 'false');
        });

        updateFocusButtons();
        syncUrlState();
      }

      function toggleSelection(id: string, opts: { additive: boolean }): void {
        if (!opts.additive) {
          if (selected.size === 1 && selected.has(id)) selected.delete(id);
          else {
            selected.clear();
            selected.add(id);
          }
        } else if (selected.has(id)) selected.delete(id);
        else selected.add(id);
        applyStates();
      }

      // ---- Focus mode: select one or more Cards, isolate the view to just
      // those + their direct neighbours — user: "can we implement a focus,
      // so once I select something (one or more cards), I can only see
      // those (for if the distance is too high)". Two related but distinct
      // mechanisms coexist here:
      //
      // 1. The advanced `hopsSelect`/`focusControls` UI above (`/map`-only,
      //    single-selection-oriented, promoted from `MapExplorer.astro`) —
      //    unchanged in its own trigger wiring below, now simply able to
      //    handle a multi-selection too since `applyFocus()`'s old
      //    `selected.size !== 1` bail-out is gone.
      // 2. `focusActive`/`enterFocus`/`exitFocus` below — a generic,
      //    always-present (both routes) explicit toggle: click "Focus" once
      //    something is selected to isolate + re-fit the camera onto the
      //    selection's neighbourhood; "← Full map"/Escape/clicking empty
      //    canvas all return to the normal view. This is deliberately an
      //    explicit action (a button/keypress), not automatic on every
      //    single click — auto-refitting the camera on every card selection
      //    would fight the existing single-select "browse this entity"
      //    flow (which already dims non-neighbours to 35% via the 5-state
      //    classification above) and make multi-select-by-shift-click
      //    jarring (the view would jump on every intermediate click).
      //
      // DIM, not hard-hide (`display:none`): both mechanisms share the same
      // `.focus-dimmed` class (opacity 0.15 nodes / 0.06 edges — already
      // defined in the stylesheet above) rather than removing elements from
      // the render. Chosen over a hard hide because "still find your way
      // back to the full map" matters more here than maximal visual
      // isolation — the Tier/Cluster compound bands also stay fully visible
      // throughout (never dimmed — same `.tier-band, .sub-band` exclusion
      // `highlight()` below already uses) so they keep reading as context
      // rather than disappearing/resizing every time focus toggles.
      let focusActive = false;
      // "Aislar" (2026-09-09 follow-up: "make a new button called 'aislar',
      // to hide all that is not being selected and related with what is
      // selected... I should be able to select multiple boxes and retain
      // those and their relations") — a second, independent mode sharing
      // every input (selection, multi-select, neighbourhood computation)
      // with Focus above, differing only in WHAT it does with the
      // out-of-scope elements: hard-hide (`display:none` via
      // `.isolated-hidden`) instead of dim (`.focus-dimmed`). Kept as its
      // own boolean/functions rather than folded into `focusActive` because
      // the two are genuinely different end states a user can compare
      // (dim-but-visible vs. gone) — see the mutual-exclusion decision
      // below, in `enterFocus`/`enterIsolate`.
      let isolateActive = false;
      // Isolate re-layout (2026-09-09 follow-up: "'aislar' works perfectly,
      // but I would like to re-arrange also, so I can reduce long
      // distances") — `applyIsolate` below hides everything outside the
      // selection's neighbourhood but, until now, left the KEPT elements at
      // their original absolute positions (the full-corpus hierarchy.ts
      // layout), so two kept Cards that started in far-apart Tiers/Clusters
      // still read as far apart on screen even with nothing rendered in
      // between. `runIsolateLayout` (below) re-runs `fcose` restricted to
      // just the currently-visible elements to pull them close together.
      //
      // Positions must be captured ONCE per isolate "session" (in
      // `enterIsolate`, before the FIRST `applyIsolate`/fcose run) and
      // restored on every path that leaves isolate mode — not just the
      // dedicated `exitIsolate` — so the graph always returns to the exact
      // same stable hierarchy.ts layout rather than wherever fcose last left
      // it. `applyIsolate` itself can run MANY times during one isolate
      // session (the selection, or the hop count, can change while isolate
      // stays active — see `applyStates`/`hopsSelect`'s own listener below),
      // each time re-laying out the (possibly different) visible subset from
      // its current positions — only the snapshot taken at session start is
      // ever restored, never an intermediate fcose result.
      let preIsolatePositions: Map<string, { x: number; y: number }> | null = null;
      function capturePreIsolatePositions(): void {
        preIsolatePositions = new Map();
        cy.nodes(':childless').forEach((n) => {
          preIsolatePositions!.set(n.id(), { x: n.position('x'), y: n.position('y') });
        });
      }
      function restorePreIsolatePositions(): void {
        if (!preIsolatePositions) return;
        const snapshot = preIsolatePositions;
        preIsolatePositions = null;
        cy.nodes(':childless').forEach((n) => {
          const pos = snapshot.get(n.id());
          if (pos) n.position(pos);
        });
      }
      /** Re-lays out just the currently-visible (non-`.isolated-hidden`)
       *  elements with `fcose`, pulling the kept Cards close together instead
       *  of leaving them at their original, possibly far-apart, hierarchy.ts
       *  coordinates. Compound Tier/Cluster bands left visible (still
       *  containing >=1 kept Card) are included in the same layout call —
       *  fcose supports compound nodes natively, sizing/positioning each
       *  band around its own visible children automatically, same as the
       *  initial `preset` layout already relies on Cytoscape doing for free.
       *  Deliberately restricted to the VISIBLE collection only (`.layout()`
       *  called on a sub-collection only repositions that sub-collection) —
       *  a hidden element's position is untouched here and either gets
       *  restored later (`restorePreIsolatePositions`) or re-laid-out itself
       *  once it becomes visible again in a later `applyIsolate` call.
       *  Never called with zero visible elements (`applyIsolate`'s own
       *  `selected.size === 0` branch returns before this point), and fcose
       *  handles a single visible Card with zero visible neighbours fine
       *  (verified: isolating a card with no relations doesn't hang/error). */
      function runIsolateLayout(): void {
        const visible = cy.elements().not('.isolated-hidden');
        if (visible.length === 0) return;
        visible
          .layout({
            name: 'fcose',
            animate: true,
            animationDuration: 300,
            randomize: false,
            fit: true,
            // Deliberately left at fcose's original 60, NOT halved — a real
            // Playwright measurement (renderedPosition-based pixel distance,
            // not model-space) showed LOWERING padding actually INCREASES
            // the on-screen gap between kept Cards here: `fit()` computes
            // zoom as (viewport - 2*padding) / bounding-box, so a smaller
            // padding leaves more usable canvas, fcose zooms IN further to
            // fill it, and the rendered pixel gap between two Cards (their
            // MODEL-space separation times that larger zoom) grows, not
            // shrinks. `nodeRepulsion`/`idealEdgeLength` below are what
            // actually control the real inter-Card gap.
            padding: 60,
            nodeDimensionsIncludeLabels: true,
            // 2026-09-09 follow-up ("more aggressive, half the space"):
            // both values found via a real bisection sweep (a throwaway
            // Playwright script driving this exact isolate flow against a
            // built preview, measuring the actual rendered pixel distance
            // between two kept, different-Tier Cards — DOI/DataCite — after
            // every combination, plus a bounding-box overlap check across
            // every kept Card AND every Tier/Cluster band on each run). The
            // old 8000/120 pair measured ~184px for that pair; sweeping
            // nodeRepulsion from 50 to 8000 (with idealEdgeLength scaled
            // proportionally) found a stable low-distance plateau at
            // nodeRepulsion ~550-700 / idealEdgeLength ~13-16 (~129-130px,
            // a real ~30% tightening, zero Card/Card or Card/band overlaps
            // anywhere in the swept range at these values) — values outside
            // that plateau in EITHER direction (both higher AND lower) were
            // measured to be WORSE (fcose's compound-aware force layout is
            // not monotonic in these parameters), and raising `gravity`/
            // `gravityCompound` to push further were measured to
            // occasionally overlap two sibling Cluster sub-bands, so are
            // deliberately left at fcose's own defaults. A full 50%
            // reduction from the shipped baseline was not reachable without
            // overlaps: the real classbox footprint (176px+ per Card) that
            // feeds fcose's own non-overlap forces sets a geometric floor
            // this pair can't cross while both Tiers still contain more
            // than one Card each — the plateau above is the tightest this
            // pair gets while staying overlap-free.
            nodeRepulsion: 600,
            idealEdgeLength: 14,
          } as unknown as cytoscape.LayoutOptions)
          .run();
      }
      function clearFocus(): void {
        cy.elements().removeClass('focus-dimmed');
      }
      function clearIsolate(): void {
        cy.elements().removeClass('isolated-hidden');
      }
      /** Union of every selected Card's N-hop neighbourhood — the one
       *  neighbourhood-computation algorithm shared by BOTH Focus (dim) and
       *  Isolate (hard-hide) below, so the two can never silently drift out
       *  of sync on what counts as "related to the selection". */
      function selectionNeighborhood(): Set<string> {
        const hops = Number(hopsSelect?.value ?? '1');
        const result = new Set<string>();
        for (const id of selected) for (const nb of nHopNeighborhood(id, hops, adjacency)) result.add(nb);
        return result;
      }
      function applyFocus(): void {
        if (selected.size === 0) {
          clearFocus();
          return;
        }
        const neighborhood = selectionNeighborhood();
        cy.nodes(':childless').forEach((n) => {
          if (!neighborhood.has(n.id())) n.addClass('focus-dimmed');
          else n.removeClass('focus-dimmed');
        });
        cy.edges().forEach((e) => {
          const inScope = neighborhood.has(e.data('source')) && neighborhood.has(e.data('target'));
          if (inScope) e.removeClass('focus-dimmed');
          else e.addClass('focus-dimmed');
        });
      }
      /** Hard-hide pass for Isolate mode: same neighbourhood/edge-scope
       *  logic as `applyFocus`, but adds/removes `.isolated-hidden`
       *  (`display:none`) instead of `.focus-dimmed` (opacity). Also hides
       *  any Tier/Cluster compound band left with zero visible children —
       *  Cytoscape does not auto-hide a compound parent just because every
       *  child got `display:none`, so without this an "isolated" view would
       *  still show empty grey boxes, defeating the point. Sub-bands are
       *  processed before their owning Tier band so a Tier whose only
       *  content was a now-fully-hidden Cluster also correctly collapses. */
      function applyIsolate(): void {
        if (selected.size === 0) {
          clearIsolate();
          return;
        }
        const neighborhood = selectionNeighborhood();
        cy.nodes(':childless').forEach((n) => {
          if (!neighborhood.has(n.id())) n.addClass('isolated-hidden');
          else n.removeClass('isolated-hidden');
        });
        cy.edges().forEach((e) => {
          const inScope = neighborhood.has(e.data('source')) && neighborhood.has(e.data('target'));
          if (inScope) e.removeClass('isolated-hidden');
          else e.addClass('isolated-hidden');
        });
        function hasVisibleChild(band: cytoscape.NodeSingular): boolean {
          let anyVisible = false;
          band.children().forEach((c) => {
            if (!c.hasClass('isolated-hidden')) anyVisible = true;
          });
          return anyVisible;
        }
        cy.nodes('.sub-band').forEach((band) => {
          if (hasVisibleChild(band)) band.removeClass('isolated-hidden');
          else band.addClass('isolated-hidden');
        });
        cy.nodes('.tier-band').forEach((band) => {
          if (hasVisibleChild(band)) band.removeClass('isolated-hidden');
          else band.addClass('isolated-hidden');
        });
        // Pull the kept elements close together (see `runIsolateLayout`'s own
        // comment) — re-run on every visibility-scope change, not just once
        // on entry, so a mid-session selection/hop-count change keeps the
        // view tight instead of reverting to the original spread-out
        // coordinates for anything newly revealed.
        runIsolateLayout();
      }
      function updateFocusButtons(): void {
        // Each toggle hides only for ITS OWN active mode, not the other
        // one — so while Isolate is active, the Focus button stays visible
        // as a direct "switch to Focus instead" affordance (and vice
        // versa), rather than forcing the user through the exit button to
        // change mode. `enterFocus`/`enterIsolate` handle the actual
        // mutual-exclusion (clearing whichever mode was on before applying
        // the new one). The shared exit button covers leaving either mode
        // back to the full map.
        if (focusToggleBtn) focusToggleBtn.hidden = focusActive || selected.size === 0;
        if (isolateToggleBtn) isolateToggleBtn.hidden = isolateActive || selected.size === 0;
        if (focusExitBtn) focusExitBtn.hidden = !(focusActive || isolateActive);
      }
      /** Enter focus mode: dim everything outside the selection's
       *  neighbourhood AND re-fit/zoom the camera onto just that
       *  neighbourhood — the part the dim-only 5-state highlighting above
       *  doesn't do, and the actual "distance is too high" complaint this
       *  feature answers (dimming alone doesn't help if the relevant cards
       *  are still scattered far apart on screen). */
      function enterFocus(): void {
        if (selected.size === 0) return;
        // Mutually exclusive with Isolate — switching straight from one to
        // the other clears the previous mode's hidden/dimmed state first,
        // rather than letting both classes coexist on the same elements.
        if (isolateActive) {
          isolateActive = false;
          clearIsolate();
          // Isolate may have re-laid-out (fcose) the visible elements —
          // switching straight to Focus (which never hides anything, so
          // every element becomes visible again immediately) must not carry
          // that squeezed-together arrangement over; restore the original
          // hierarchy.ts positions first, same as a full `exitIsolate` would.
          restorePreIsolatePositions();
        }
        focusActive = true;
        applyFocus();
        const neighborhood = selectionNeighborhood();
        const eles = cy.nodes(':childless').filter((n) => neighborhood.has(n.id()));
        if (eles.length > 0) cy.animate({ fit: { eles, padding: 80 } }, { duration: 300 });
        updateFocusButtons();
      }
      function exitFocus(): void {
        focusActive = false;
        clearFocus();
        resetView();
        updateFocusButtons();
      }
      /** Enter isolate mode: hard-hide everything outside the selection's
       *  neighbourhood (see `applyIsolate`) and re-lay-out + re-fit/zoom the
       *  camera onto the kept set. Unlike `enterFocus`, the camera fit here
       *  comes from `runIsolateLayout`'s own `fit: true` (inside
       *  `applyIsolate`) rather than a separate `cy.animate({fit...})` call —
       *  fitting to a collection that's ABOUT to be re-laid-out by fcose
       *  would just fit the OLD (pre-relayout, far-apart) positions and then
       *  immediately jump once fcose's own fit takes over a moment later. */
      function enterIsolate(): void {
        if (selected.size === 0) return;
        if (focusActive) {
          focusActive = false;
          clearFocus();
        }
        isolateActive = true;
        // Snapshot BEFORE the first `applyIsolate`/fcose run of this
        // session — see `capturePreIsolatePositions`'s own comment for why
        // this can't just happen inside `applyIsolate` itself (that runs
        // repeatedly for the lifetime of the session).
        capturePreIsolatePositions();
        applyIsolate();
        updateFocusButtons();
      }
      function exitIsolate(): void {
        isolateActive = false;
        clearIsolate();
        restorePreIsolatePositions();
        resetView();
        updateFocusButtons();
      }
      // Legacy advanced-mode behaviour (`/map`-only, promoted unchanged from
      // `MapExplorer.astro`): changing the hop count always recomputes the
      // preview for whichever mode is currently relevant, defaulting to
      // Focus's dim-only preview when Isolate isn't engaged — matches this
      // control's pre-existing "always live-update" behaviour rather than
      // gating it behind the generic `focusActive` toggle.
      hopsSelect?.addEventListener('change', () => {
        if (isolateActive) applyIsolate();
        else applyFocus();
      });
      document.getElementById('map2-focus-clear')?.addEventListener('click', () => {
        clearFocus();
        if (hopsSelect) hopsSelect.value = '1';
      });
      focusToggleBtn?.addEventListener('click', enterFocus);
      isolateToggleBtn?.addEventListener('click', enterIsolate);
      // Shared exit: only one of the two modes is ever actually active (see
      // the mutual-exclusion handling above), so at most one of these two
      // calls does real work.
      focusExitBtn?.addEventListener('click', () => {
        if (focusActive) exitFocus();
        if (isolateActive) exitIsolate();
      });
      document.addEventListener('keydown', (evt) => {
        if (evt.key !== 'Escape') return;
        if (focusActive) exitFocus();
        else if (isolateActive) exitIsolate();
        else if (selected.size > 0) {
          selected.clear();
          applyStates();
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.map2-entity-btn').forEach((btn) => {
        btn.addEventListener('click', (evt) => {
          const additive = (evt as MouseEvent).shiftKey || (evt as MouseEvent).metaKey || (evt as MouseEvent).ctrlKey;
          toggleSelection(btn.dataset.selectId ?? '', { additive });
          const id = btn.dataset.selectId;
          if (id) cy.animate({ center: { eles: cy.$id(id) }, zoom: Math.max(cy.zoom(), 1) }, { duration: 200 });
          if (hopsSelect) {
            if (isolateActive) applyIsolate();
            else applyFocus();
          }
        });
      });

      cy.on('tap', 'node', (evt) => {
        // Tapping a band's own background (not one of its children) fires
        // this too, since a compound parent is a real node at that position
        // — it isn't a selectable entity, so ignore it (tier bands AND their
        // nested sub-bands alike).
        if (isBandNode(evt.target)) return;
        // Shift OR ctrl/meta both extend the selection (matches the Layers-
        // panel entity buttons' own additive-click handling above — a user
        // reaching for either modifier to multi-select on the canvas gets
        // the same result).
        const original = evt.originalEvent as MouseEvent | undefined;
        const additive = (original?.shiftKey || original?.metaKey || original?.ctrlKey) ?? false;
        toggleSelection(evt.target.id(), { additive });
      });
      cy.on('tap', (evt) => {
        if (evt.target === cy) {
          selected.clear();
          applyStates();
        }
      });

      function highlight(node: cytoscape.NodeSingular): void {
        if (selected.size > 0) return;
        const neighborhood = node.closedNeighborhood();
        // Compound band parents (tier bands AND nested sub-bands) must never
        // receive `.dimmed`: a compound child's rendered opacity is its own
        // opacity times every ancestor's, so dimming a band an entity lives
        // in (directly, or — for T1/T2 — via its sub-band) drags that
        // entity's EFFECTIVE opacity down to 0.12 even though its own
        // `.highlighted` class/opacity was correctly 1 — reproduced live
        // (node.effectiveOpacity() measured 0.12 on the hovered node) before
        // this fix, since `node.closedNeighborhood()` never includes a
        // node's own compound ancestors so every band always fell on the
        // dimmed side of the difference below.
        const dimmable = cy.elements().not('.tier-band, .sub-band');
        dimmable.difference(neighborhood).addClass('dimmed').removeClass('highlighted');
        neighborhood.removeClass('dimmed').addClass('highlighted');
      }
      function clearHighlight(): void {
        if (selected.size > 0) return;
        cy.elements().not('.tier-band, .sub-band').removeClass('dimmed highlighted');
      }
      cy.on('mouseover', 'node', (evt) => {
        if (isBandNode(evt.target)) return;
        highlight(evt.target);
      });
      cy.on('mouseout', 'node', clearHighlight);

      const tooltip = document.getElementById('map2-tooltip');
      const tooltipName = tooltip?.querySelector<HTMLElement>('.map2-tooltip__name');
      const tooltipMeta = tooltip?.querySelector<HTMLElement>('.map2-tooltip__meta');
      function showTooltip(node: cytoscape.NodeSingular, pageX: number, pageY: number): void {
        if (!tooltip || !tooltipName || !tooltipMeta) return;
        tooltipName.textContent = node.data('label');
        const subtypeLabel = node.data('subtypeLabel');
        const metaParts = [`${i18n.tooltipType}: ${node.data('typeLabel')}`, `${i18n.tooltipLayer}: ${node.data('layerLabel')}`];
        if (subtypeLabel) metaParts.push(`${i18n.tooltipSubtype}: ${subtypeLabel}`);
        tooltipMeta.textContent = metaParts.join(' · ');
        tooltip.hidden = false;
        const maxLeft = window.innerWidth - 300;
        const maxTop = window.innerHeight - 100;
        tooltip.style.left = `${Math.min(pageX + 14, Math.max(0, maxLeft))}px`;
        tooltip.style.top = `${Math.min(pageY + 14, Math.max(0, maxTop))}px`;
      }
      function hideTooltip(): void {
        if (tooltip) tooltip.hidden = true;
      }
      cy.on('mouseover', 'node', (evt) => {
        if (isBandNode(evt.target)) return;
        const original = evt.originalEvent as MouseEvent | undefined;
        showTooltip(evt.target, original?.clientX ?? 0, original?.clientY ?? 0);
      });
      cy.on('mousemove', 'node', (evt) => {
        if (isBandNode(evt.target)) return;
        const original = evt.originalEvent as MouseEvent | undefined;
        if (original) showTooltip(evt.target, original.clientX, original.clientY);
      });
      cy.on('mouseout', 'node', hideTooltip);
      cy.on('tap', hideTooltip);

      // ---- Search-as-you-type over the in-page payload — no fetch needed
      // at ~27 nodes (report §B2: "/map2 doesn't need [the search-index
      // fetch]... name/summary/tags are already in the in-page payload"). ----
      const searchInput = document.getElementById('map2-search-input') as HTMLInputElement | null;
      const searchResults = document.getElementById('map2-search-results');
      function renderSearchResults(query: string): void {
        if (!searchResults) return;
        searchResults.innerHTML = '';
        if (!query) {
          searchResults.hidden = true;
          return;
        }
        const scored = graph.nodes
          .map((entry) => ({ entry, score: scoreSearchEntry({ name: entry.name, summary: entry.summary }, query) }))
          .filter((r) => r.score >= 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 12);
        if (scored.length === 0) {
          const li = document.createElement('li');
          li.textContent = i18n.searchNoResults;
          searchResults.appendChild(li);
          searchResults.hidden = false;
          return;
        }
        for (const { entry } of scored) {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          const badges = ` — ${entry.layerLabel} · ${entry.typeLabel}${entry.noRelations ? ` · ${i18n.noRelationsBadge}` : ''}`;
          btn.textContent = `${entry.name}${badges}`;
          btn.addEventListener('click', () => {
            toggleSelection(entry.id, { additive: false });
            cy.animate({ center: { eles: cy.$id(entry.id) }, zoom: Math.max(cy.zoom(), 1) }, { duration: 200 });
            searchResults.hidden = true;
            if (searchInput) searchInput.value = '';
          });
          li.appendChild(btn);
          searchResults.appendChild(li);
        }
        searchResults.hidden = false;
      }
      searchInput?.addEventListener('input', () => renderSearchResults(searchInput.value));
      searchInput?.addEventListener('blur', () => {
        window.setTimeout(() => {
          if (searchResults) searchResults.hidden = true;
        }, 150);
      });

      // ---- Panel collapse toggles. ----
      const bodyEl = document.querySelector('.map2-body');
      function wireToggle(buttonId: string, panelKey: string): void {
        const btn = document.getElementById(buttonId);
        btn?.addEventListener('click', () => {
          if (!bodyEl) return;
          const collapsed = new Set((bodyEl.getAttribute('data-collapsed') ?? '').split(' ').filter(Boolean));
          const nowCollapsed = collapsed.has(panelKey);
          if (nowCollapsed) collapsed.delete(panelKey);
          else collapsed.add(panelKey);
          btn.setAttribute('aria-expanded', nowCollapsed ? 'true' : 'false');
          bodyEl.setAttribute('data-collapsed', [...collapsed].join(' '));
        });
      }
      wireToggle('map2-layers-toggle', 'layers');
      wireToggle('map2-inspector-toggle', 'inspector');

      // ---- Inspector panel resize (report follow-up: "can be displayed
      // inside the record tab (that should allow the user for resizing)").
      // A simple functional drag handle on the panel's left edge — no new
      // dependency, no modal. Width persists for the session only
      // (sessionStorage, not a durable preference) via the CSS custom
      // property the grid-template-columns rule above reads. ----
      // User feedback: the old fixed 280-640px range was too tight ("I
      // cannot resize the pane too much, I should be able more liberty").
      // MIN stays close to the old floor (raised slightly to 300px, since
      // the richer inline record content added this pass — description,
      // facets, grouped relations — needs a bit more room than the old
      // badges+flat-list view did to stay readable). MAX is now dynamic
      // rather than a bigger static number: it's recomputed from the real
      // canvas/layers widths so the inspector can never crowd the canvas
      // column down to nothing on a narrower viewport.
      const INSPECTOR_WIDTH_MIN = 300;
      const INSPECTOR_WIDTH_MAX_STATIC = 1100;
      const CANVAS_MIN_WIDTH = 320;
      const INSPECTOR_WIDTH_KEY = 'map2InspectorWidth';
      function effectiveInspectorMax(): number {
        const bodyWidth = (bodyEl as HTMLElement | null)?.getBoundingClientRect().width ?? window.innerWidth;
        const layersWidth = document.getElementById('map2-layers-panel')?.getBoundingClientRect().width ?? 40;
        const dynamicMax = bodyWidth - layersWidth - CANVAS_MIN_WIDTH;
        return Math.max(INSPECTOR_WIDTH_MIN, Math.min(INSPECTOR_WIDTH_MAX_STATIC, dynamicMax));
      }
      function setInspectorWidth(px: number): void {
        const max = effectiveInspectorMax();
        const clamped = Math.min(max, Math.max(INSPECTOR_WIDTH_MIN, px));
        (bodyEl as HTMLElement | null)?.style.setProperty('--map2-inspector-w', `${clamped}px`);
        const handle = document.getElementById('map2-inspector-resize');
        handle?.setAttribute('aria-valuenow', String(Math.round(clamped)));
        handle?.setAttribute('aria-valuemax', String(Math.round(max)));
        handle?.setAttribute('aria-valuemin', String(INSPECTOR_WIDTH_MIN));
        try {
          window.sessionStorage.setItem(INSPECTOR_WIDTH_KEY, String(clamped));
        } catch {
          // sessionStorage can throw in a locked-down/private-browsing
          // context — resizing still works for the current interaction,
          // it just won't persist across a reload. Not fatal either way.
        }
      }
      window.addEventListener('resize', () => {
        // Reclamp on viewport changes — nothing else re-enforces the cap
        // once it's set as a fixed CSS custom property, so a window shrink
        // after a wide manual resize could otherwise crowd the canvas
        // column down to nothing.
        const inspectorEl = document.getElementById('map2-inspector');
        const current = inspectorEl?.getBoundingClientRect().width ?? 320;
        setInspectorWidth(current);
      });
      try {
        const stored = window.sessionStorage.getItem(INSPECTOR_WIDTH_KEY);
        if (stored) setInspectorWidth(Number(stored));
      } catch {
        // same non-fatal storage-unavailable case as above.
      }
      const resizeHandle = document.getElementById('map2-inspector-resize');
      resizeHandle?.addEventListener('pointerdown', (evt) => {
        const startX = (evt as PointerEvent).clientX;
        const inspectorEl = document.getElementById('map2-inspector');
        const startWidth = inspectorEl?.getBoundingClientRect().width ?? 320;
        resizeHandle.setPointerCapture((evt as PointerEvent).pointerId);
        function onMove(moveEvt: PointerEvent): void {
          // Handle sits on the panel's LEFT edge — dragging left (negative
          // delta) widens the panel, dragging right narrows it.
          setInspectorWidth(startWidth - (moveEvt.clientX - startX));
        }
        function onUp(): void {
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
        }
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
      });
      resizeHandle?.addEventListener('keydown', (evt) => {
        const inspectorEl = document.getElementById('map2-inspector');
        const current = inspectorEl?.getBoundingClientRect().width ?? 320;
        const step = 20;
        if (evt.key === 'ArrowLeft') {
          setInspectorWidth(current + step);
          evt.preventDefault();
        } else if (evt.key === 'ArrowRight') {
          setInspectorWidth(current - step);
          evt.preventDefault();
        }
      });
      if (window.matchMedia('(max-width: 900px)').matches && bodyEl) {
        bodyEl.setAttribute('data-collapsed', 'layers inspector');
      }

      // ---- Zoom/pan buttons + keyboard equivalents (normal wheel rate —
      // report §A4: the old 0.25 sensitivity was a 4x slowdown). ----
      document.querySelectorAll<HTMLButtonElement>('[data-map-action]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-map-action');
          if (action === 'zoom-in') cy.zoom({ level: cy.zoom() * 1.25, renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 } });
          else if (action === 'zoom-out') cy.zoom({ level: cy.zoom() * 0.8, renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 } });
          else if (action === 'reset') resetView();
        });
      });
      const step = 60;
      canvas.addEventListener('keydown', (e) => {
        const pan = cy.pan();
        switch (e.key) {
          case 'ArrowUp':
            cy.pan({ x: pan.x, y: pan.y + step });
            break;
          case 'ArrowDown':
            cy.pan({ x: pan.x, y: pan.y - step });
            break;
          case 'ArrowLeft':
            cy.pan({ x: pan.x + step, y: pan.y });
            break;
          case 'ArrowRight':
            cy.pan({ x: pan.x - step, y: pan.y });
            break;
          case '+':
          case '=':
            cy.zoom(cy.zoom() * 1.25);
            break;
          case '-':
          case '_':
            cy.zoom(cy.zoom() * 0.8);
            break;
          case '0':
            resetView();
            break;
          default:
            return;
        }
        e.preventDefault();
      });

      // ---- Facets (`/map`-only, `showAdvanced`) — promoted from
      // `MapExplorer.astro`. Absent DOM (`input[data-facet]`) on `/map2`
      // means `currentFilters()` always returns empty arrays and
      // `applyFilters()`'s `active` flag stays false there, a correct no-op. ----
      function currentFilters(): FacetFilters {
        const get = (facet: string) =>
          [...document.querySelectorAll<HTMLInputElement>(`input[data-facet="${facet}"]:checked`)].map((el) => el.value);
        return { layers: get('layer'), types: get('type'), governances: get('governance'), tags: get('tag') };
      }
      function applyFilters(): void {
        const filters = currentFilters();
        const active = filters.layers.length + filters.types.length + filters.governances.length + filters.tags.length > 0;
        cy.nodes(':childless').forEach((n) => {
          const node = nodeById.get(n.id());
          if (!node) return;
          const facetNode: FacetableNode = { type: node.type, layer: node.layer, governance: node.governance, tags: node.tags };
          if (!active || matchesFacets(facetNode, filters)) n.removeClass('filtered-out');
          else n.addClass('filtered-out');
        });
        syncUrlState();
      }
      document.querySelectorAll<HTMLInputElement>('input[data-facet]').forEach((el) => el.addEventListener('change', applyFilters));
      document.getElementById('map2-filters-clear')?.addEventListener('click', () => {
        document.querySelectorAll<HTMLInputElement>('input[data-facet]').forEach((el) => (el.checked = false));
        applyFilters();
      });

      if (statusEl) {
        statusEl.dataset.idleHtml = statusEl.innerHTML;
        statusEl.dataset.selectionTemplate = statusEl.getAttribute('data-selection-template') ?? '';
      }
      void LAYER_ORDER; // kept imported for parity/documentation of layer order source-of-truth

      // ---- URL query state (`/map`-only in practice: `syncUrlState` is
      // called unconditionally above/in `applyFilters`, but with no facet/
      // focus DOM on `/map2` the serialized state there is just `sel=...`,
      // harmless). Promoted from `MapExplorer.astro`. ----
      function syncUrlState(): void {
        const filters = currentFilters();
        const state: MapUrlState = {
          layers: [...filters.layers],
          types: [...filters.types],
          governances: [...filters.governances],
          tags: [...filters.tags],
          selected: [...selected],
          hops: (Number(hopsSelect?.value ?? '1') as 1 | 2 | 3) || 1,
        };
        const qs = serializeMapUrlState(state);
        history.replaceState(null, '', `${location.pathname}${qs}`);
      }
      function applyUrlState(): void {
        const state = parseMapUrlState(location.search);
        for (const [facet, values] of [
          ['layer', state.layers],
          ['type', state.types],
          ['governance', state.governances],
          ['tag', state.tags],
        ] as const) {
          for (const v of values) {
            const el = document.querySelector<HTMLInputElement>(`input[data-facet="${facet}"][value="${CSS.escape(v)}"]`);
            if (el) el.checked = true;
          }
        }
        if (hopsSelect) hopsSelect.value = String(state.hops);
        for (const id of state.selected) selected.add(id);
        applyFilters();
        applyStates();
        if (state.selected.length === 1) applyFocus();
      }
      applyUrlState();
    }

    try {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMap);
      else initMap();
    } catch {
      showError();
    }

    function initOnboarding(): void {
      const banner = document.getElementById('map2-onboarding');
      const dismissBtn = document.getElementById('map2-onboarding-dismiss');
      if (!banner || !dismissBtn) return;
      const key = banner.getAttribute('data-onboarding-key') ?? 'map2OnboardingDismissed';
      try {
        if (!localStorage.getItem(key)) banner.hidden = false;
      } catch {
        banner.hidden = false;
      }
      dismissBtn.addEventListener('click', () => {
        banner.hidden = true;
        try {
          localStorage.setItem(key, '1');
        } catch {
          /* no-op */
        }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initOnboarding);
    else initOnboarding();
  </script>
</Base>
