    :global(.map2-open-full-page) {
      display: inline-block;
      margin-top: 0.5rem;
      padding: 0.35rem 0.7rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--link, #0969da);
      background: var(--bg-subtle, #f6f8fa);
      border: 1px solid var(--border, #d0d7de);
      border-radius: 6px;
      cursor: pointer;
    }
    :global(.map2-inspector-fullpage-status) {
      color: var(--muted-fg, #57606a);
      font-size: 0.85rem;
    }
    :global(.map2-inspector-fullpage-error) {
      color: var(--danger-fg, #cf222e);
    }
    :global(.map2-inspector-fullpage-status a) {
      color: var(--link, #0969da);
    }
