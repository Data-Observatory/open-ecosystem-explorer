    openFullPageLabel: 'Ver página completa',
    fullPageLoadErrorLabel: 'No se pudo cargar la ficha completa.',
    loadingFullPageLabel: 'Cargando ficha completa…',
    resizeHandleLabel: 'Redimensionar panel de ficha',
