      <div id="map2-state-key" class="map2-state-key" aria-hidden="true" hidden>
        <span class="state-dot state-selected"></span>{t.stateSelected}
        <span class="state-dot state-upstream"></span>{t.stateUpstream}
        <span class="state-dot state-downstream"></span>{t.stateDownstream}
        <span class="state-dot state-shared"></span>{t.stateShared}
      </div>
    </div>

    <noscript>
      <p role="note">{t.noJs}</p>
    </noscript>

    <div id="map2-onboarding" class="map2-onboarding" role="note" data-onboarding-key={`${routeSegment}OnboardingDismissed`} hidden>
      <p class="map2-onboarding__title">{t.onboardTitle}</p>
      {t.onboardLines.map((line) => <p>{line}</p>)}
      <button type="button" id="map2-onboarding-dismiss">{t.onboardDismiss}</button>
    </div>

    <div class="map2-body" data-collapsed="layers">
      <aside id="map2-layers-panel" class="map2-layers" aria-label={t.layersTitle}>
        <div class="map2-panel-header">
          <h2>{t.layersTitle}</h2>
          <button type="button" id="map2-layers-toggle" aria-expanded="false" aria-controls="map2-layers-panel" aria-label={t.expandLayers}>
            »
          </button>
        </div>
        <div class="map2-panel-body">
          {layerGroups.map((g) => (
            <details class="map2-layer" data-layer={g.layer} open={g.layer === 'identifier' || g.layer === 'cross-cutting'}>
              <summary>
                {g.layerLabel} <span class="map2-layer__count">({g.count})</span>
              </summary>
              <ul>
                {g.entities.map((e) => (
                  <li>
                    <button type="button" class="map2-entity-btn" data-select-id={e.id} aria-label={`${e.name} — ${g.layerLabel}`}>
                      {e.name}
                      {e.subtypeLabel && <span class="map2-badge">{e.subtypeLabel}</span>}
                      {e.noRelations && (
                        <span class="map2-badge map2-badge--warn" title={t.noRelationsBadge}>
                          !
                        </span>
                      )}
                    </button>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </aside>

      <div class="map2-canvas-col">
        <div id="map2-tooltip" class="map2-tooltip" role="status" hidden>
          <p class="map2-tooltip__name"></p>
          <p class="map2-tooltip__meta"></p>
        </div>
        <div id="map2-canvas" tabindex="0" role="img" aria-label={t.intro}></div>
        <p id="map2-error" role="alert" hidden>{t.loadError}</p>

        <details class="map2-legend-overlay">
          <summary>{t.legendToggle}</summary>
          <DiagramLegend items={legendItems} locale={locale} groupByLayer layerLabels={LAYER_LABELS[locale]} />
        </details>
      </div>

      <aside id="map2-inspector" class="map2-inspector" aria-label={t.inspectorTitle}>
        <div
          id="map2-inspector-resize"
          class="map2-inspector-resize"
          role="separator"
          aria-orientation="vertical"
          aria-label={t.resizeHandleLabel}
          aria-valuenow="320"
          aria-valuemin="300"
          aria-valuemax="1100"
          tabindex="0"
        >
        </div>
        <div class="map2-panel-header">
          <button type="button" id="map2-inspector-toggle" aria-expanded="true" aria-controls="map2-inspector" aria-label={t.collapseInspector}>
            »
          </button>
          <h2>{t.inspectorTitle}</h2>
        </div>
        <div class="map2-panel-body">
          <div id="map2-inspector-content"></div>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/json" id="map2-graph-data" set:html={graphPayload} />
  <script type="application/json" id="map2-style-data" set:html={stylePayload} />
  <script type="application/json" id="map2-i18n-data" set:html={JSON.stringify(panelI18n)} />

