---
// Shared explorer behind BOTH `/{loc}/map` (whole ~133-entity corpus) and
// `/{loc}/map2` (a fixed curated ~33-entity subset for a first-time
// visitor) — the two page routes are thin wrappers differing only in
// `entityIds`/`showAdvanced`/`crossLinkHref`/`crossLinkLabel` props.
//
// History: built `/map2`-ONLY (Opus evaluation report, 2026-09-06 follow-up
// pass) as a deliberately SEPARATE component from the then-existing
// `MapExplorer.astro` (fcose layout, no hierarchy/class-box rendering), so
// `/map` could stay byte-for-byte unchanged while this component was
// iterated on and fixed across many rounds (explicit scope at the time:
// "map 2 only, so we can test it"). Promoted to replace `/map` entirely on
// 2026-09-07 once that iteration was validated (user: "implement this
// layout, to map" -> "Full map2 experience") — `MapExplorer.astro` is
// deleted; this file absorbed its unique features (Focus mode, facet
// chips, URL query-state — see `showAdvanced` below) rather than the other
// way around, since this component's rendering core (hierarchy layout,
// class-box nodes, hover-dim fix, fetch-injected inline full-record panel)
// was the more capable, more recently bug-fixed of the two.
//
// Shares the pure, already-unit-tested lib modules (facets/search-score/
// graph-state/url-state/curated/subtypes/palette) plus hierarchy.ts
// (tier+depth ranking), node-svg.ts (class-box rendering),
// palette-overrides.ts + subtype-labels.ts.
//
// What changed vs. `/map`, and why (see specs.md §7's one-line `/map2` row
// and CHANGELOG.md for the fuller writeup):
//  - App-shell layout (Base.astro's new `appShell` prop) — the old page had
//    a `100vw` breakout plus an `82vh`-tall canvas row stacked among other
//    document-flow chrome, which produced BOTH a horizontal scrollbar
//    (100vw includes the scrollbar gutter) and a vertical one (chrome height
//    + 82vh routinely exceeded the viewport) — a real CSS defect, not a
//    layout preference (report §A2).
//  - `layout: 'preset'` driven by `hierarchy.ts`'s tier+depth ranking,
//    instead of `fcose`'s force-directed layout pinned via one arbitrary
//    leaf node per layer band — fcose never guaranteed any hierarchy at all
//    (report §A7); this gives the literal "concepts/institutions at top,
//    instruments at bottom" shape the user described, computed from the
//    predicates' own real-world meaning, not memo-layer membership.
//  - Class-box node rendering (`node-svg.ts`) instead of a 20x20 coloured
//    dot — more information visible without a click, closer to
//    template_example.html's UML-class-box vocabulary (report §A9/§B5).
//  - Normal wheel-zoom rate (was a 4x-slower `wheelSensitivity: 0.25`),
//    `ResizeObserver`-driven `cy.resize()`, search restored from the
//    in-page payload (no network fetch needed at ~27 nodes).
//  - "Chrome diet": Layers panel starts collapsed to its rail, no Inspector
//    placeholder bullets, the 5-state colour key stays hidden until the
//    first selection, a 2-line onboarding banner, and the type/layer legend
//    lives as a small collapsed overlay in a canvas corner instead of taking
//    document-flow space below the whole shell (report §B6).
//  - `community`'s fill colour overridden (still `#0969da` on `/map` and
//    every Mermaid diagram) — it collided with `repository` and `standard`
//    at small size (report §A8).
import Base from '../layouts/Base.astro';
import DiagramLegend, { type LegendItem } from './DiagramLegend.astro';
import { getSiteIndex } from '../content/site-index.js';
import { getEntityTypesVocab, getTagsVocab } from '../content/vocab-index.js';
import { layerForType } from '../lib/model/vocab.js';
import { resolveProse } from '../lib/i18n/resolve.js';
import { shapeForLayer } from '../lib/mermaid/palette.js';
import { map2TypeFill } from '../lib/map/palette-overrides.js';
import type { LocaleCode } from '../i18n/locales.js';
import type { EntityType, Entity } from '../lib/model/types.js';
import { subtypeOf, SUBTYPE_FIELD } from '../lib/model/subtypes.js';
import { localizedSubtypeLabel } from '../lib/model/subtype-labels.js';
import { hasNoRelations } from '../lib/map/facets.js';
import { filterToEntitySet } from '../lib/map/curated.js';
import { locales, defaultLocale } from '../i18n/locales.js';
import { regionOf } from '../lib/map/hierarchy.js';

interface Props {
  locale: LocaleCode;
  // Fixed curated subset for `/map2`; omitted (whole corpus) for `/map` —
  // promoted from `MapExplorer.astro` (removed 2026-09-07: this component now
  // serves both routes, see this file's header comment).
  entityIds?: readonly string[];
  crossLinkHref: string;
  crossLinkLabel: string;
  // Facet-chip filtering, Focus mode, and URL query-state — clutter at
  // `/map2`'s ~33-entity curated scale (never enabled there), load-bearing at
  // `/map`'s full ~133-entity corpus (also promoted from `MapExplorer.astro`).
  showAdvanced?: boolean;
}
const { locale, entityIds, crossLinkHref, crossLinkLabel, showAdvanced = false } = Astro.props;

const LAYER_LABELS: Record<LocaleCode, Record<string, string>> = {
  es: {
    identifier: 'Identificadores',
    agency: 'Agencias de registro',
    index: 'Índices',
    'institutional-system': 'Sistemas institucionales',
    regional: 'Capa regional',
    'cross-cutting': 'Transversal (estándares, comunidades, coaliciones)',
  },
  en: {
    identifier: 'Identifiers',
    agency: 'Registration agencies',
    index: 'Indices',
    'institutional-system': 'Institutional systems',
    regional: 'Regional layer',
    'cross-cutting': 'Cross-cutting (standards, communities, coalitions)',
  },
};
const GOVERNANCE_LABELS: Record<LocaleCode, Record<string, string>> = {
  es: {
    commercial: 'Comercial',
    nonprofit: 'Sin fines de lucro',
    community: 'Comunitaria',
    intergovernmental: 'Intergubernamental',
    'public-agency': 'Agencia pública',
    academic: 'Académica',
    unknown: 'Desconocida',
  },
  en: {
    commercial: 'Commercial',
    nonprofit: 'Nonprofit',
    community: 'Community',
    intergovernmental: 'Intergovernmental',
    'public-agency': 'Public agency',
    academic: 'Academic',
    unknown: 'Unknown',
  },
};

const index = await getSiteIndex();
const vocab = await getEntityTypesVocab();
const tagsVocab = await getTagsVocab();

// Short display label for a tier-2 sub-band (2026-09-08 nested-band split):
// `tagsVocab` labels are the full tag label ("región: Europa" / "region:
// Europe") — nested under an already-labeled tier band, repeating "región:"
// would be redundant, so this takes just the part after the namespace
// colon. Falls back to the raw region id if the tag has no vocab entry
// (shouldn't happen — `regionOf` only ever returns a real `region:*` value
// or the always-defined `global`).
function regionShortLabel(region: string, loc: LocaleCode): string {
  const full = tagsVocab.get(`region:${region}`)?.label[loc] ?? tagsVocab.get(`region:${region}`)?.label.en;
  if (!full) return region;
  const idx = full.indexOf(': ');
  return idx === -1 ? full : full.slice(idx + 2);
}

// Same Mermaid-shape-vocabulary approximation as `/map`, but with the
// Stage-0 fix: `subroutine` (agency's layer) had been silently folded into
// the same Cytoscape `'rectangle'` as `rect` (institutional-system) — report
// §A8: "12 types collapse to 5 shapes... agency and cris/repository are the
// same rectangle". Given `'cut-rectangle'` instead so it reads as a
// distinct box shape at the low-zoom "dot" LOD (see the client script).
const CYTO_SHAPE_BY_MERMAID_SHAPE: Record<string, string> = {
  stadium: 'round-rectangle',
  subroutine: 'cut-rectangle',
  cylinder: 'barrel',
  rect: 'rectangle',
  parallelogram: 'rhomboid',
  hexagon: 'hexagon',
};

const typeStyle: Record<string, { fill: string; shape: string }> = {};
for (const type of [...vocab.keys()] as EntityType[]) {
  const layer = layerForType(vocab, type);
  typeStyle[type] = { fill: map2TypeFill(type), shape: CYTO_SHAPE_BY_MERMAID_SHAPE[shapeForLayer(layer)] ?? 'ellipse' };
}

const predicateStyle: Record<string, { color: string; line: string }> = {};
for (const [id, p] of index.predicates) {
  predicateStyle[id] = { color: p.style.color, line: p.style.line };
}
function predicateLabelFor(predicateId: string, direction: 'out' | 'in'): string {
  const p = index.predicates.get(predicateId as never);
  const map = direction === 'out' ? p?.label : p?.inverseLabel;
  return map?.[locale] ?? map?.en ?? predicateId;
}

const nameById = new Map<string, string>();
for (const e of index.entities.values()) nameById.set(e.id, resolveProse(index, e.id, locale).prose.name ?? e.name);

// Governance/status/type-specific "fields" shown on the class box — a small,
// hand-picked set per type (report §B5 Option 2), not every schema field:
// enough to answer "what makes this different from its neighbour" (the
// OpenAlex/Scopus complaint) without turning the box into a full record.
const GOV_LABEL = { governance: locale === 'es' ? 'Gobernanza' : 'Governance', status: locale === 'es' ? 'Estado' : 'Status' };
const STATUS_LABELS: Record<LocaleCode, Record<string, string>> = {
  es: { active: 'Activo', deprecated: 'Obsoleto', superseded: 'Reemplazado', planned: 'Planificado', unknown: 'Desconocido' },
  en: { active: 'Active', deprecated: 'Deprecated', superseded: 'Superseded', planned: 'Planned', unknown: 'Unknown' },
};

interface ClassBoxFieldSpec {
  label: string;
  value: string;
}
function classBoxFields(e: (typeof allNodes)[number]): ClassBoxFieldSpec[] {
  const fields: ClassBoxFieldSpec[] = [{ label: GOV_LABEL.governance, value: e.governanceLabel }];
  fields.push({ label: GOV_LABEL.status, value: e.statusLabel });
  return fields;
}

// Report follow-up ("not sure if the full record should be a full isolated
// page; can be displayed inside the record tab") — the Inspector's single-
// selection view already showed name/badges/summary/full relations; sources
// and every type-specific field (persistentIdScheme, harvestProtocols,
// isoStandard, ...) were the two things missing to make it a genuine inline
// record rather than a preview. Rather than hand-enumerating each of the 12
// types' own field lists (duplicating `types.ts`'s own type-specific
// interfaces here), this generically dumps whatever fields exist on the raw
// entity beyond the common `EntityBase` set (already shown elsewhere in the
// panel) and the type's own subtype field (already shown as `subtypeLabel`).
const COMMON_ENTITY_KEYS = new Set([
  'id',
  'type',
  'name',
  'aka',
  'url',
  'identifiers',
  'status',
  'governance',
  'outputLicence',
  'codebase',
  'since',
  'until',
  'tags',
  'disciplines',
  'geography',
  'relations',
  'sources',
  'lastReviewed',
  'isolated',
  'note',
]);
function humanizeFieldKey(key: string): string {
  // camelCase -> "Camel case" (mirrors subtypes.ts's own humanizeSubtype
  // spacing/capitalisation convention, applied to a field NAME instead of an
  // enum value).
  const spaced = key.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
}
function formatFieldValue(value: unknown): string | undefined {
  if (value === undefined || value === null || value === '') return undefined;
  if (Array.isArray(value)) return value.length > 0 ? value.join(', ') : undefined;
  if (typeof value === 'boolean') return value ? (locale === 'es' ? 'Sí' : 'Yes') : locale === 'es' ? 'No' : 'No';
  return String(value);
}
function extraFieldsFor(e: Entity): ClassBoxFieldSpec[] {
  const subtypeField = SUBTYPE_FIELD[e.type];
  const raw = e as unknown as Record<string, unknown>;
  const out: ClassBoxFieldSpec[] = [];
  for (const key of Object.keys(raw)) {
    if (COMMON_ENTITY_KEYS.has(key) || key === subtypeField) continue;
    const formatted = formatFieldValue(raw[key]);
    if (formatted === undefined) continue;
    out.push({ label: humanizeFieldKey(key), value: formatted });
  }
  return out;
}

const allNodes = [...index.entities.values()].map((e) => {
  const layer = layerForType(vocab, e.type);
  const { prose, fallback } = resolveProse(index, e.id, locale);
  const typeEntry = vocab.get(e.type);
  const subtype = subtypeOf(e);
  const degree = index.degree.get(e.id) ?? { in: 0, out: 0 };
  const outgoing = (index.outgoing.get(e.id) ?? []).map((r) => ({
    predicate: r.predicate,
    predicateLabel: predicateLabelFor(r.predicate, 'out'),
    id: r.to,
    name: nameById.get(r.to) ?? r.to,
    note: r.note,
    since: r.since,
  }));
  const incoming = (index.incoming.get(e.id) ?? []).map((r) => ({
    predicate: r.predicate,
    predicateLabel: predicateLabelFor(r.predicate, 'in'),
    id: r.from,
    name: nameById.get(r.from) ?? r.from,
    note: r.note,
    since: r.since,
  }));
  return {
    id: e.id,
    type: e.type,
    typeLabel: typeEntry?.label[locale] ?? typeEntry?.label.en ?? e.type,
    layer,
    layerLabel: LAYER_LABELS[locale][layer] ?? layer,
    subtype,
    subtypeLabel: subtype ? localizedSubtypeLabel(subtype, locale) : undefined,
    name: prose.name ?? e.name,
    aka: e.aka,
    summary: prose.summary,
    body: prose.body,
    fallback,
    governance: e.governance,
    governanceLabel: GOVERNANCE_LABELS[locale][e.governance] ?? e.governance,
    // Nested tier-2 sub-band key/label (2026-09-08) — precomputed server-side
    // since `tagsVocab` (needed to resolve the label) isn't available in the
    // client `<script>` bundle; the client only ever reads these two fields.
    region: regionOf(e.tags),
    regionLabel: regionShortLabel(regionOf(e.tags), locale),
    status: e.status,
    statusLabel: STATUS_LABELS[locale][e.status] ?? e.status,
    tags: e.tags,
    disciplines: e.disciplines,
    geography: e.geography,
    lastReviewed: e.lastReviewed,
    degree,
    noRelations: hasNoRelations(degree),
    outgoing,
    incoming,
    sources: e.sources.map((s) => ({ url: s.url, title: s.title, accessed: s.accessed, note: s.note })),
    extraFields: extraFieldsFor(e),
  };
});
const allEdges = [...index.entities.keys()].flatMap((id) =>
  (index.outgoing.get(id) ?? []).map((r) => ({ from: r.from, to: r.to, predicate: r.predicate, derived: r.derived })),
);

// `/map` passes no `entityIds` (the whole corpus) — `filterToEntitySet`
// against the full id list is a no-op there (every edge's endpoints already
// survive), same as it always was on the old `MapExplorer.astro`; skip the
// call entirely rather than run a pure no-op over 133 nodes/183 edges.
const { nodes, edges } = entityIds ? filterToEntitySet(allNodes, allEdges, entityIds) : { nodes: allNodes, edges: allEdges };

// The inspector's single-entity relation lists must show the entity's TRUE
// full relation set (matching `/[locale]/entity/[id]/`'s real outDegree/
// inDegree), not `filterToEntitySet`'s canvas-only trimmed one — a real
// entity often relates to things outside a curated subset (e.g., on `/map2`,
// `datacite-metadata-schema` is `implements`-ed by 5 real repositories, only
// 3 of which are curated there). The curated/trimmed `outgoing`/`incoming`
// stay untouched for everything canvas/layout-related (isolated-node
// detection, multi-select shared-neighbour logic) — only these two extra
// `full*` fields, read solely by the single-selection inspector, carry the
// uncurated truth, each ref tagged `inSet` so the renderer knows whether it
// can be clicked-to-select on this canvas or only linked out to its own page.
// On `/map` (no `entityIds`) every id is trivially "in set" — `fullOutgoing`/
// `fullIncoming` end up identical to `outgoing`/`incoming` there, so this
// stays correct rather than becoming dead branches at full scale.
const idSet = entityIds ? new Set(entityIds) : new Set(allNodes.map((n) => n.id));
const fullById = new Map(allNodes.map((n) => [n.id, n]));
const nodesWithFields = nodes.map((n) => {
  const full = fullById.get(n.id);
  const fullOutgoing = (full?.outgoing ?? []).map((r) => ({ ...r, inSet: idSet.has(r.id) }));
  const fullIncoming = (full?.incoming ?? []).map((r) => ({ ...r, inSet: idSet.has(r.id) }));
  return { ...n, classBoxFields: classBoxFields(n), fullOutgoing, fullIncoming };
});

// One number for "relations" everywhere (home page `stats.edgeCount`, this
// intro line, `/graph.json`): authored relations, each counted once. Symmetric
// predicates (`interoperates-with`) are mirrored in `index.outgoing` so they
// *draw and read* from both ends (`derived: true`) — those mirrors are drawn
// but are not extra relations, so they are excluded from the count.
const relationCount = edges.filter((e) => !e.derived).length;
const graphPayload = JSON.stringify({
  nodes: nodesWithFields,
  edges: edges.map(({ from, to, predicate }) => ({ from, to, predicate })),
});
const stylePayload = JSON.stringify({ types: typeStyle, predicates: predicateStyle });
const entityTypes = [...new Set(nodes.map((n) => n.type))].sort() as EntityType[];

const legendItems: LegendItem[] = entityTypes
  .filter((t) => vocab.has(t))
  .map((t) => {
    const entry = vocab.get(t)!;
    return { type: t, label: entry.label[locale] ?? entry.label.en ?? t, layer: entry.layer, shape: shapeForLayer(entry.layer), fill: map2TypeFill(t) };
  });

interface LayerPanelEntity {
  id: string;
  name: string;
  subtypeLabel?: string;
  noRelations: boolean;
}
interface LayerPanelGroup {
  layer: string;
  layerLabel: string;
  count: number;
  entities: LayerPanelEntity[];
}
import { LAYER_ORDER } from '../lib/mermaid/layers.js';
const layerGroups: LayerPanelGroup[] = LAYER_ORDER.map((layer) => {
  const layerNodes = nodes.filter((n) => n.layer === layer);
  return {
    layer,
    layerLabel: LAYER_LABELS[locale][layer] ?? layer,
    count: layerNodes.length,
    entities: layerNodes
      .sort((a, b) => a.name.localeCompare(b.name))
      .map((n) => ({ id: n.id, name: n.name, subtypeLabel: n.subtypeLabel, noRelations: n.noRelations })),
  };
}).filter((g) => g.count > 0);

// --- Facet options (promoted from `MapExplorer.astro`): only values
// actually present in the corpus, never the full closed vocab. Rendered
// only when `showAdvanced` (i.e. on `/map`, never `/map2` — see Props). ---
const layersPresent = layerGroups.map((g) => ({ value: g.layer, label: g.layerLabel, count: g.count }));
const governancesPresent = [...new Set(nodes.map((n) => n.governance))]
  .map((g) => ({ value: g, label: GOVERNANCE_LABELS[locale][g] ?? g, count: nodes.filter((n) => n.governance === g).length }))
  .sort((a, b) => b.count - a.count);
const typesPresent = entityTypes.map((t) => ({
  value: t,
  label: vocab.get(t)?.label[locale] ?? vocab.get(t)?.label.en ?? t,
  count: nodes.filter((n) => n.type === t).length,
}));
const tagIdsPresent = [...new Set(nodes.flatMap((n) => n.tags))];
const tagsPresent = tagIdsPresent
  .map((tagId) => ({ value: tagId, label: tagsVocab.get(tagId)?.label[locale] ?? tagsVocab.get(tagId)?.label.en ?? tagId }))
  .sort((a, b) => a.label.localeCompare(b.label));

// Route-aware chrome: this component now backs both `/map` (no `entityIds`)
// and `/map2` (curated `entityIds`) — see Props/header comment.
const routeSegment = entityIds ? 'map2' : 'map';
const switcherHrefs = Object.fromEntries(locales.map((l) => [l.code, `/${l.code}/${routeSegment}/`])) as Record<LocaleCode, string>;
const pageTitle = entityIds ? { es: 'Conceptos esenciales', en: 'Essential concepts' } : { es: 'Mapa', en: 'Map' };

const strings = {
  es: {
    intro: `${nodes.length} entidades, ${relationCount} relaciones.`,
    tableLink: 'Ver como tabla (equivalente accesible)',
    noJs: 'Este mapa requiere JavaScript. Mientras tanto, explora la tabla de entidades.',
    zoomIn: 'Acercar',
    zoomOut: 'Alejar',
    reset: 'Restablecer vista',
