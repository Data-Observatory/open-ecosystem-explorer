---
// Standard-level relations, grouped by predicate, outgoing then incoming
// (specs.md §7's entity-page row). Each row links to the related entity's
// own page — the site's primary means of navigation between entities.
import type { EntityId, GraphIndex, PredicateId } from '../lib/model/types.js';
import type { LocaleCode } from '../../src/i18n/locales.js';
import { getUiStrings } from '../i18n/ui.js';
import { getEntityTypesVocab } from '../content/vocab-index.js';

export interface Props {
  index: GraphIndex;
  entityId: EntityId;
  locale: LocaleCode;
}

const { index, entityId, locale } = Astro.props;
const ui = getUiStrings(locale);

function name(id: EntityId): string {
  return index.prose.get(locale)?.get(id)?.name ?? index.entities.get(id)?.name ?? id;
}

const typeVocab = await getEntityTypesVocab();
function typeOf(id: EntityId): string {
  const type = index.entities.get(id)?.type;
  if (!type) return 'unknown';
  return typeVocab.get(type)?.label[locale] ?? typeVocab.get(type)?.label.en ?? type;
}

function label(predicate: PredicateId, direction: 'label' | 'inverseLabel'): string {
  const def = index.predicates.get(predicate);
  return def?.[direction]?.[locale] ?? def?.[direction]?.es ?? predicate;
}

function groupByPredicate(edges: readonly { predicate: PredicateId; from: EntityId; to: EntityId; note?: string }[], otherEnd: 'to' | 'from') {
  const groups = new Map<PredicateId, typeof edges>();
  for (const e of edges) {
    if (!groups.has(e.predicate)) groups.set(e.predicate, [] as unknown as typeof edges);
    (groups.get(e.predicate) as unknown as (typeof edges)[number][]).push(e);
  }
  return [...groups.entries()].map(([predicate, es]) => ({
    predicate,
    otherEnd,
    entries: es,
  }));
}

const outgoing = index.outgoing.get(entityId) ?? [];
const incoming = index.incoming.get(entityId) ?? [];
const outGroups = groupByPredicate(outgoing, 'to');
const inGroups = groupByPredicate(incoming, 'from');
---

{
  outGroups.map((group) => (
    <section class="relation-group">
      <h4>{label(group.predicate, 'label')}</h4>
      <table>
        <caption class="visually-hidden">
          {label(group.predicate, 'label')} — {ui.entity.outgoing}
        </caption>
        <tbody>
          {group.entries.map((e) => (
            <tr>
              <td>
                <a href={`/${locale}/entity/${e.to}/`}>{name(e.to)}</a> <span class="type-label">({typeOf(e.to)})</span>
              </td>
              <td>{e.note ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))
}
{
  inGroups.map((group) => (
    <section class="relation-group">
      <h4>{label(group.predicate, 'inverseLabel')}</h4>
      <table>
        <caption class="visually-hidden">
          {label(group.predicate, 'inverseLabel')} — {ui.entity.incoming}
        </caption>
        <tbody>
          {group.entries.map((e) => (
            <tr>
              <td>
                <a href={`/${locale}/entity/${e.from}/`}>{name(e.from)}</a> <span class="type-label">({typeOf(e.from)})</span>
              </td>
              <td>{e.note ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))
}

<style>
  .relation-group {
    margin: 1rem 0;
  }
  .relation-group h4 {
    margin: 0 0 0.25rem;
    font-size: 0.95rem;
  }
  .relation-group table {
    width: 100%;
    border-collapse: collapse;
  }
  .relation-group td {
    padding: 0.3rem 0.5rem;
    border-bottom: 1px solid var(--border, #d0d7de);
  }
  .type-label {
    color: var(--muted-fg, #57606a);
    font-size: 0.85em;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
